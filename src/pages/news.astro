---
import Layout from '../layouts/Layout.astro';

const news = [
  {
    title: 'New IV Therapy — Vitamin Drip Now Available at Chivacare',
    date: 'June 2025',
    img: 'https://chivacare.com/assets/uploads/img_promotions/main/1750648234_clip.jpg',
    desc: 'Chivacare now offers IV Vitamin Therapy — a direct intravenous infusion of vitamins and minerals for energy, immunity, and overall wellness.',
  },
  {
    title: 'Insomnia Without Medication Program Launched',
    date: 'June 2025',
    img: 'https://chivacare.com/assets/uploads/img_promotions/main/1750649404_clip.jpg',
    desc: "Chivacare's new insomnia program uses TMS and non-pharmacological approaches — so patients can sleep better without relying on sleeping pills.",
  },
  {
    title: 'New Pain Relief & Shockwave Packages for 2025',
    date: 'May 2025',
    img: 'https://chivacare.com/assets/uploads/img_promotions/main/1750671343_clip.jpg',
    desc: 'We have launched new physical therapy packages: Pain Relief, Shockwave, and Intensive Pain Treatment — tailored for various musculoskeletal conditions.',
  },
  {
    title: 'PMS Device Now Available — New Technology for Pain & Numbness',
    date: 'May 2025',
    img: 'https://chivacare.com/assets/uploads/img_services/main/1620446495_.jpg',
    desc: 'Chivacare adds the PMS electromagnetic device for treating chronic pain, numbness, and office syndrome without medication or surgery.',
  },
  {
    title: 'TMS Depression & Insomnia Treatment Packages Updated',
    date: 'May 2025',
    img: 'https://chivacare.com/assets/uploads/img_promotions/main/1750671106_clip.jpg',
    desc: 'New TMS packages for depression and insomnia are now available — with 0% interest installment options up to 6 months.',
  },
  {
    title: 'Dry Needling Program Now Offered by Specialist Physicians',
    date: 'April 2025',
    img: 'https://chivacare.com/assets/uploads/img_promotions/main/1750671229_clip.jpg',
    desc: 'Western needle technique (Dry Needling) for deep pain relief at the source — now performed by our specialist rehabilitation physicians starting at 600 THB.',
  },
];
---

<Layout
  title="News & Events - Chivacare Chiang Mai"
  description="Latest news, clinic updates, and treatment announcements from Chivacare Chiang Mai."
>
  <!-- Breadcrumb -->
  <div class="container" style="padding-top:80px;">
    <ol class="breadcrumb" style="background:transparent;padding-left:0;">
      <li><a href="/">Home</a></li>
      <li><a href="javascript:;">News &amp; Articles</a></li>
      <li class="active">News &amp; Events</li>
    </ol>
  </div>

  <!-- Title -->
  <section style="padding:20px 0 20px;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="head-title">
          <h1 class="title -animated-underline -show-line scrollanimation animated fadeInDown" style="font-size:28px;">News &amp; Events</h1>
        </div>
        <p style="margin-top:16px;">Latest news and updates from Chivacare — new services, treatment programs, and clinic announcements.</p>
      </div>
    </div>
  </section>

  <!-- News Cards -->
  <section style="padding:20px 0 48px;background:#f7fafc;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="row">
          {news.map((n) => (
            <div class="col-md-6" style="margin-bottom:24px;">
              <div class="content-wrapper _h-100pct _dp-f has-background-white _bsd-default _bdrd-4px" style="align-items:stretch;">
                <img src={n.img} alt={n.title} style="width:180px;min-height:180px;object-fit:cover;border-radius:4px 0 0 4px;flex-shrink:0;" />
                <div style="padding:20px;display:flex;flex-direction:column;">
                  <p style="color:#999;font-size:0.85em;margin-bottom:6px;">{n.date}</p>
                  <h4 style="color:#30c1b8;font-size:15px;line-height:1.4;">{n.title}</h4>
                  <p style="color:#555;flex:1;">{n.desc}</p>
                  <a href="#" class="btn-wrapper has-text-blue-primary" style="margin-top:8px;">
                    <span class="-text">Read more &rarr;</span>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
