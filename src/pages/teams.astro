    img: 'https://chivacare.com/assets/uploads/img_teams/1/main/1750652313_1.jpg',
  },
  {
    name: 'Dr. Pichamonchai Suwannachat',
    title: 'Rehabilitation Medicine Specialist',
    sub: 'Physical Medicine & Rehabilitation',
    img: 'https://chivacare.com/assets/uploads/img_teams/1/main/1750652362_1.jpg',
  },
