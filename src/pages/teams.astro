---

<Layout
  title="Medical Team & Specialists - Chivacare Chiang Mai"
  description="Meet the board-certified neurologists, rehabilitation physicians, physical therapists, and occupational therapists of Chivacare Chiang Mai."
>
  <!-- Hero Banner -->
  <div style="background:url('https://chivacare.com/assets/layouts/frontend/images/bg-teams.jpg') center/cover no-repeat;padding-top:80px;min-height:240px;display:flex;align-items:flex-end;">
    <div style="width:100%;background:linear-gradient(to top,rgba(0,0,0,0.55) 0%,transparent 100%);padding:32px 0 24px;">
      <div class="container _pdvrm-15px">
        <ol class="breadcrumb" style="background:transparent;padding-left:0;margin-bottom:8px;">
          <li><a href="/" style="color:rgba(255,255,255,0.8);">Home</a></li>
          <li class="active" style="color:white;">Medical Team &amp; Specialists</li>
        </ol>
        <h1 style="color:white;font-size:30px;margin:0;text-shadow:0 1px 4px rgba(0,0,0,0.4);">Medical Team &amp; Specialists</h1>
      </div>
    </div>
  </div>

  <!-- Intro -->
  <section style="padding:28px 0 20px;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <p style="margin-top:0;font-size:1.02em;line-height:1.7;">Board-certified physicians and licensed therapists with extensive clinical experience in brain and nervous system disorders, rehabilitation medicine, and physical therapy.</p>
      </div>
    </div>
  </section>

  <!-- Physicians -->
  <section style="padding:20px 0 40px;background:#f7fafc;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="head-title">
          <h2 class="title -animated-underline -show-line scrollanimation animated fadeInDown">Specialist Physicians</h2>
        </div>
        <div class="row" style="margin-top:32px;">
          {doctors.map((d) => (
            <div class="col-md-4 col-sm-6" style="margin-bottom:24px;text-align:center;">
              <div class="content-wrapper _h-100pct _dp-f _fdrt-cl has-background-white _bsd-default _bdrd-4px" style="align-items:center;padding:24px 16px;">
                <img src={d.img} alt={d.name} class="img-responsive" style="border-radius:50%;width:160px;height:160px;object-fit:cover;margin:0 auto 16px;" />
                <h4 style="color:#30c1b8;margin-bottom:4px;">{d.name}</h4>
                <p style="font-weight:bold;margin-bottom:4px;">{d.title}</p>
                <p style="color:#666;font-size:0.9em;">{d.sub}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Therapists -->
  <section style="padding:40px 0 48px;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="head-title">
          <h2 class="title -animated-underline -show-line scrollanimation animated fadeInDown">Physical &amp; Occupational Therapists</h2>
        </div>
        <div class="row" style="margin-top:32px;">
          {therapists.map((t) => (
            <div class="col-md-4 col-sm-6" style="margin-bottom:24px;text-align:center;">
              <div class="content-wrapper _h-100pct _dp-f _fdrt-cl has-background-white _bsd-default _bdrd-4px" style="align-items:center;padding:24px 16px;">
                <img src={t.img} alt={t.name} class="img-responsive" style="border-radius:50%;width:160px;height:160px;object-fit:cover;margin:0 auto 16px;" />
                <h4 style="color:#30c1b8;margin-bottom:4px;">{t.name}</h4>
                <p style="font-weight:bold;">{t.title}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
