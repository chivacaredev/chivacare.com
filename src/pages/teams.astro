  },
  {
    name: 'Asst. Prof. Dr. Surat Tanprawate',
    title: 'Neurologist — Co-founder',
    sub: 'Specialist in Headache & Migraine, Stroke, Movement Disorders',
    img: 'https://chivacare.com/assets/uploads/img_teams/1/main/1618810463_1.jpg',
  },
  {
    name: 'Dr. Theradon Pinitchachon',
    title: 'Neurologist',
    sub: 'Specialist in Brain & Nervous System Disorders',
    img: 'https://chivacare.com/assets/uploads/img_teams/1/main/1750652207_1.jpg',
  },
  {
    name: 'Dr. Wimolrat Tharanop',
    title: 'Rehabilitation Medicine Specialist',
