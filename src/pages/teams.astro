    title: 'Licensed Physical Therapist',
    sub: 'Manual therapy, shockwave, exercise therapy',
    img: 'https://chivacare.com/assets/uploads/img_teams/2/main/1646803864_2.jpg',
  },
  {
    name: 'Supakorn Theeradechushakdi (Fai)',
    title: 'Licensed Physical Therapist',
    sub: 'Electrotherapy, exercise rehabilitation',
    img: 'https://chivacare.com/assets/uploads/img_teams/2/main/1646808555_2.jpg',
  },
  {
    name: 'Supawida Samanasak (Fern)',
    title: 'Licensed Physical Therapist',
    sub: 'Manual therapy, post-surgical rehabilitation',
    img: 'https://chivacare.com/assets/uploads/img_teams/2/main/1750346694_2.jpg',
  },
  {
    name: 'Sukrinrat Boondi (Tangmo)',
    title: 'Licensed Physical Therapist',
    sub: 'Neurological rehabilitation, pain management',
    img: 'https://chivacare.com/assets/uploads/img_teams/2/main/1750346672_2.jpg',
  },
  {
    name: 'Araya Noiysuwan (Min)',
    title: 'Licensed Physical Therapist',
