---
import Layout from '../layouts/Layout.astro';

const posts = [
  { title: 'Tongue Stiffness, Difficulty Speaking, Difficulty Swallowing — What Causes This?', desc: 'Understanding neurological symptoms affecting the tongue and swallowing function — when to see a specialist.', img: 'https://chivacare.com/assets/uploads/img_blog/main/1769481720_clip.jpg', cat: 'Brain & Nervous System' },
  { title: "Saying Goodbye to the 'Pain-Massage-Pain' Loop: Why Physical Therapy Is the Only Way Out for Office Syndrome Sufferers", desc: "Tired of massages that don't bring lasting relief? Learn the root causes of office syndrome and how physical therapy solves the problem.", img: 'https://chivacare.com/assets/uploads/img_blog/main/1769481720_clip.jpg', cat: 'Physical Therapy' },
  { title: 'PMS Device for Pain, Numbness, and Office Syndrome', desc: 'A new electromagnetic wave device that treats pain, numbness, and office syndrome — without medication or surgery.', img: 'https://chivacare.com/assets/uploads/img_blog/main/1769295467_.jpg', cat: 'Physical Therapy' },
  { title: 'Stroke Rehabilitation with TMS Technology', desc: 'There are many ways to treat stroke patients today — TMS technology offers a non-invasive solution for recovery.', img: 'https://chivacare.com/assets/uploads/img_blog/main/1634630572_.jpg', cat: 'Brain & Nervous System' },
  { title: 'Innovative Migraine Relief with TMS', desc: 'Migraines disrupting your daily life? Say goodbye to migraines with TMS — the new electromagnetic wave technology!', img: 'https://chivacare.com/assets/uploads/img_blog/main/1634630351_.jpg', cat: 'Brain & Nervous System' },
  { title: 'Treating "Depression and Insomnia" Without Medication', desc: "If you're experiencing stress, depression, loss of appetite, insomnia, or restlessness — read this before taking more medication.", img: 'https://chivacare.com/assets/uploads/img_blog/main/1630908030_.jpg', cat: 'Mental Health' },
  { title: 'TMS: Another Option for Treating Hemiparesis and Paralysis', desc: 'In stroke patients, TMS therapy can improve weakness and paralysis that affects daily life.', img: 'https://chivacare.com/assets/uploads/img_blog/main/1630219036_.jpg', cat: 'Rehabilitation' },
  { title: 'Warning! Premature Knee Osteoarthritis — Prevention Is Better Than Cure', desc: 'Knee osteoarthritis is common, especially in seniors — and significantly affects daily life. Learn how to prevent it.', img: 'https://chivacare.com/assets/uploads/img_blog/main/1629654445_.jpg', cat: 'Physical Therapy' },
  { title: 'Reducing Migraine Pain with Shockwave?', desc: 'Migraines can come from many causes — over 50% of migraine sufferers also have office syndrome. Shockwave may help.', img: 'https://chivacare.com/assets/uploads/img_blog/main/1629195092_.jpg', cat: 'Brain & Nervous System' },
  { title: 'Muscle Weakness: Risk of Muscle Atrophy!', desc: 'Muscle weakness leads to muscle atrophy if left untreated. Learn the warning signs and how to prevent deterioration.', img: 'https://chivacare.com/assets/uploads/img_blog/main/1627354180_.jpg', cat: 'Physical Therapy' },
  { title: 'How TMS Helps Treat Depression', desc: 'TMS (Transcranial Magnetic Stimulation) is a proven, medication-free treatment for depression. Here is how it works.', img: 'https://chivacare.com/assets/uploads/img_blog/main/1626604573_.jpg', cat: 'Mental Health' },
  { title: 'Carpal Tunnel Syndrome — What Causes It?', desc: 'Carpal tunnel syndrome is one of the most common nerve compression conditions. Find out causes, symptoms, and treatment options.', img: 'https://chivacare.com/assets/uploads/img_blog/main/1625990074_.jpg', cat: 'Physical Therapy' },
];
---

<Layout
  title="Health Articles - Chivacare Chiang Mai"
  description="Health articles on brain conditions, mental health, physical therapy, rehabilitation, and geriatric care from Chivacare specialists."
>
  <!-- Breadcrumb -->
  <div class="container" style="padding-top:80px;">
    <ol class="breadcrumb" style="background:transparent;padding-left:0;">
      <li><a href="/">Home</a></li>
      <li><a href="javascript:;">News &amp; Articles</a></li>
      <li class="active">Health Articles</li>
    </ol>
  </div>

  <!-- Title -->
  <section style="padding:20px 0 20px;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="head-title">
          <h1 class="title -animated-underline -show-line scrollanimation animated fadeInDown" style="font-size:28px;">Health Articles</h1>
        </div>
      </div>
    </div>
  </section>

  <!-- Article Grid -->
  <section style="padding:20px 0 48px;background:#f7fafc;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="row">
          {posts.map((p) => (
            <div class="col-md-4 col-sm-6" style="margin-bottom:24px;">
              <div class="content-wrapper _h-100pct _dp-f _fdrt-cl has-background-white _bsd-default _bdrd-4px">
                <img class="img-responsive" src={p.img} alt={p.title} style="width:100%;height:200px;object-fit:cover;border-radius:4px 4px 0 0;" />
                <div style="padding:16px;flex:1;display:flex;flex-direction:column;">
                  <p style="color:#30c1b8;font-size:0.85em;margin-bottom:6px;">{p.cat}</p>
                  <h4 style="font-size:15px;line-height:1.4;">{p.title}</h4>
                  <p style="color:#666;font-size:0.9em;flex:1;">{p.desc}</p>
                  <a href="#" class="btn-wrapper has-text-blue-primary" style="margin-top:10px;">
                    <span class="-text">Read more &rarr;</span>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Pagination -->
        <div class="text-center" style="margin-top:32px;">
          <ul class="pagination">
            <li class="active"><a href="#">1</a></li>
            <li><a href="#">2</a></li>
            <li><a href="#">3</a></li>
            <li><a href="#">Next &raquo;</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
