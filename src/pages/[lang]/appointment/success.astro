---
// Legacy Appointment::success() (views/step5): thank-you text from the site settings,
// plus the booking summary Step4 saved before redirecting here.
import Wizard from '../../../components/appointment/Wizard.astro';
import { W } from '../../../components/appointment/strings';
import { site } from '../../../lib/db';
import { langPaths, pick, type Lang } from '../../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = W[lang];
---

<Wizard lang={lang} step={5}>
  <div class="mx-auto mb-12 bg-white p-6 shadow-[0_50px_50px_rgba(0,4,12,.05),0_4px_15px_rgba(0,0,0,.05),0_0_5px_rgba(0,4,12,.05)] sm:w-1/2">
    <div class="prose-legacy" set:html={pick(site, 'thankyou_description', lang)} />
    <div id="appt-booked" hidden class="mt-6 border-t border-[#dbdbdb] pt-6 text-center">
      <h3 class="text-xl font-medium text-navy">{s.summary}</h3>
      <dl id="appt-summary" class="mx-auto mt-4 grid max-w-md grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-left text-sm"></dl>
      <p id="appt-confirm" class="mt-4" data-email={s.confirmEmail} data-phone={s.confirmPhone}></p>
    </div>
  </div>
</Wizard>

<script>
  import { clear, loadBooked } from '../../../components/appointment/state';
  clear();

  const booked = loadBooked();
  if (booked?.rows?.length) {
    document.getElementById('appt-summary')!.replaceChildren(
      ...booked.rows.flatMap(([k, v]) => {
        const dt = document.createElement('dt');
        dt.className = 'font-medium';
        dt.textContent = k;
        const dd = document.createElement('dd');
        dd.textContent = v;
        return [dt, dd];
      }),
    );
    const p = document.getElementById('appt-confirm')!;
    // Existing patients skip the email field, so fall back to their phone number.
    const strong = document.createElement('strong');
    strong.textContent = booked.email || booked.phone;
    p.replaceChildren(`${booked.email ? p.dataset.email : p.dataset.phone} `, strong);
    document.getElementById('appt-booked')!.hidden = false;
  }
</script>
