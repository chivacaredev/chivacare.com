---
import Layout from '../../../../layouts/Layout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import TeamGroupSlider from '../../../../components/teams/TeamGroupSlider.astro';
import {
  appointmentUrl,
  teamGroupsWithItems,
  teamPhoto,
  teamTimes,
  tt,
} from '../../../../components/teams/teams';
import { getTeams, theme } from '../../../../lib/db';
import { LANGS, pick, url, type Lang } from '../../../../lib/i18n';
import { stripHtml } from '../../../../lib/text';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => getTeams().map((team) => ({ params: { lang, id: String(team.id) }, props: { team } })));
}

const lang = Astro.params.lang as Lang;
const { team } = Astro.props;
const name = pick(team, 'title', lang);
const proficient = pick(team, 'proficient', lang);
const detail = pick(team, 'detail', lang);
const times = teamTimes(team);
// Legacy detail view only listed group 2 (physio/OT) below the profile.
const physioGroup = teamGroupsWithItems().find((g) => g.id === 2);

const facts = [
  { icon: 'skill_icon_black.png', label: tt(lang, 'skill'), value: pick(team, 'skill', lang) },
  { icon: 'tool_icon_black.png', label: tt(lang, 'tool'), value: pick(team, 'tool', lang) },
  { icon: 'lang_icon_black.png', label: tt(lang, 'lang'), value: pick(team, 'langskill', lang) },
];
---

<Layout lang={lang} title={name} description={stripHtml(detail).slice(0, 160) || proficient} image={teamPhoto(team)}>
  <section class="main-contactus">
    <Breadcrumb lang={lang} items={[{ label: tt(lang, 'breadcrumb'), href: url(lang, 'teams') }, { label: name }]} />

    <div class="container-site py-8">
      <h2 class="section-title !mb-6">{proficient || name}</h2>
    </div>

    <div
      class="bg-cover bg-center md:bg-fixed py-12"
      style={`background-image:url('${theme('chivacare_clinic.jpg')}')`}
    >
      <div class="container-site">
        <div class="rounded-2xl bg-white p-6 shadow-[0_50px_50px_rgba(0,4,12,.05),0_4px_15px_rgba(0,0,0,.05),0_0_5px_rgba(0,4,12,.05)]">
          <div class="mx-auto mb-9 w-full px-8 md:w-1/3">
            <img
              class="mx-auto aspect-square w-full rounded-full border-[10px] border-white object-cover shadow-soft"
              src={teamPhoto(team)}
              alt={team.photomain}
              title={name}
            />
          </div>
          <h4 class="text-center text-xl text-teal">{name}</h4>
          <div class="py-4 text-center">
            <a href={appointmentUrl(lang, team)} class="btn-primary is-teal rounded-2xl">{tt(lang, 'appointment')}</a>
          </div>

          <div class="mx-auto mb-9 grid gap-4 sm:grid-cols-3 md:w-10/12 md:pl-[8.33%]">
            {
              facts.map((f) => (
                <div class="flex items-start gap-4 pb-2.5 text-left">
                  <img src={theme(`chiva-icon/${f.icon}`)} alt="" width="32" height="32" class="size-8 shrink-0" />
                  <div>
                    <b class="font-medium">{f.label}</b>
                    <br />
                    {f.value || '-'}
                  </div>
                </div>
              ))
            }
          </div>

          {
            times.length > 0 && (
              <div class="mx-auto mb-4 md:w-10/12 md:pl-[8.33%]">
                <div class="flex items-start gap-4">
                  <img src={theme('chiva-icon/calendar_icon.png')} alt="" width="32" height="32" class="size-8 shrink-0" />
                  <div>
                    <b class="font-medium">{tt(lang, 'times')}</b>
                    <ul class="mt-2 flex flex-wrap gap-2">
                      {times.map((time) => (
                        <li class="rounded-lg border border-teal px-3 py-1 text-sm text-teal-dark">{time.time}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>

    <div class="container-site my-12 py-8">
      <h4 class="mb-4 text-center text-xl font-bold">{tt(lang, 'education')}</h4>
      <div class="prose-legacy" set:html={detail} />
    </div>

    {physioGroup && physioGroup.items.length > 0 && <TeamGroupSlider lang={lang} group={physioGroup} subtitle={tt(lang, 'physio')} />}
  </section>
</Layout>
