---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us - Chivacare Chiang Mai"
  description="Contact Chivacare Clinic - Brain & Pain Management Center in Chiang Mai. Call, message via Line, or visit our clinic on Sirimangkalajarn Road."
>
  <section class="page-banner" style="padding:120px 0 60px;background:#f7fafc;text-align:center;">
    <div class="container">
      <h1 style="color:#30c1b8;">Contact Us</h1>
      <p>We're here to help. Reach out by phone, Line, or visit us in person.</p>
    </div>
  </section>

  <section style="padding:60px 0;">
    <div class="container">
      <div class="row">
        <div class="col-md-6">
          <h3 style="color:#30c1b8;">Chivacare Clinic</h3>
          <p><strong>Brain & Pain Management Center</strong></p>
          <p>
            8 Soi 11, Sirimangkalajarn Road,<br />
            Suthep Sub-district, Mueang District,<br />
            Chiang Mai 50200, Thailand
          </p>
          <p>
            <strong>Phone:</strong> +66 (0) 96-980-0126<br />
            <strong>Phone:</strong> +66 (0) 52-005-457<br />
            <strong>Line:</strong> @chivacare<br />
            <strong>Email:</strong> info@chivacare.com
          </p>
          <p>
            <strong>Opening Hours:</strong><br />
            Monday - Sunday: 9:00 AM - 7:00 PM
          </p>
          <div style="margin-top:20px;">
            <a href="https://line.me/R/ti/p/@sam6768c" target="_blank" class="btn btn-success">Message on Line</a>
            <a href="tel:+66969800126" class="btn btn-primary">Call Now</a>
          </div>
        </div>
        <div class="col-md-6">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3777.0!2d98.97!3d18.79!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTjCsDQ3JzI0LjAiTiA5OMKwNTgnMTIuMCJF!5e0!3m2!1sen!2sth!4v1700000000000"
            width="100%"
            height="400"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</Layout>
