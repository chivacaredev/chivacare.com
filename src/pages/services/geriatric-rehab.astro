---
import Layout from '../../layouts/Layout.astro';

const programs = [
  { title: 'Dry Needling Program', desc: 'Needle insertion therapy that improves blood circulation and relieves deep muscle pain through targeted stimulation by specialist physicians.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620446495_.jpg' },
  { title: 'PMS Electromagnetic Wave Program', desc: 'Technology-based therapy that stimulates the nervous and brain systems to restore normal function — without medication.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620446506_.jpg' },
  { title: 'Post-Surgery Recovery Program', desc: 'Physical therapist-designed rehabilitation plans to support recovery following surgical procedures.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620378034_.jpg' },
  { title: 'Shockwave Program', desc: 'Shock wave treatment targeting pain areas to stimulate tissue healing and provide lasting pain relief.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620973383_.jpg' },
  { title: 'Pain Relief Program', desc: 'Direct pain management program addressing the root causes of pain for comprehensive, long-lasting relief.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620378076_.jpg' },
  { title: 'Post-stroke Rehabilitation', desc: 'Intensive programs to restore mobility, speech, and daily function after stroke — supervised by specialist physicians.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620375204_.jpg' },
  { title: 'Fall Prevention Program', desc: 'Balance training, strength building, and home safety assessment designed for older adults at risk of falls.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620377995_.jpg' },
  { title: 'Cognitive Stimulation', desc: 'Activities and exercises to preserve cognitive function and quality of life in early dementia patients.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620375189_.jpg' },
  { title: 'Chronic Pain Management', desc: 'Specialized pain management tailored for older adults with arthritis, degenerative joints, and chronic conditions.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620377943_.jpg' },
];
---

<Layout
  title="Geriatric Rehabilitation Center - Chivacare Chiang Mai"
  description="Comprehensive rehabilitation programs for older adults: post-stroke recovery, fall prevention, cognitive stimulation, and chronic pain management."
>
  <!-- Breadcrumb -->
  <div class="container" style="padding-top:80px;">
    <ol class="breadcrumb" style="background:transparent;padding-left:0;">
      <li><a href="/">Home</a></li>
      <li><a href="javascript:;">Our Services</a></li>
      <li class="active">Geriatric Rehabilitation Center</li>
    </ol>
  </div>

  <!-- Intro -->
  <section style="padding:20px 0 40px;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="head-title">
          <h1 class="title -animated-underline -show-line scrollanimation animated fadeInDown" style="font-size:28px;">Geriatric Rehabilitation Center</h1>
        </div>
        <p style="margin-top:20px;">Our Geriatric Rehabilitation Center provides comprehensive, multidisciplinary rehabilitation for older adults. Our team of rehabilitation medicine physicians, physical therapists, and occupational therapists work together to help elderly patients regain independence, manage chronic conditions, and maintain quality of life.</p>
      </div>
    </div>
  </section>

  <!-- Programs -->
  <section style="padding:20px 0 40px;background:#f7fafc;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="head-title">
          <h2 class="title -animated-underline -show-line scrollanimation animated fadeInDown">Treatment Programs at Chivacare</h2>
        </div>
        <div class="row" style="margin-top:32px;">
          {programs.map((p) => (
            <div class="col-md-4 col-sm-6" style="margin-bottom:24px;">
              <div class="content-wrapper _h-100pct _dp-f _fdrt-cl has-background-white _bsd-default _bdrd-4px">
                <img class="img-responsive" src={p.img} alt={p.title} style="width:100%;height:200px;object-fit:cover;border-radius:4px 4px 0 0;" />
                <div style="padding:16px;flex:1;">
                  <h4 style="color:#30c1b8;">{p.title}</h4>
                  <p>{p.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding:48px 0;">
    <div class="container text-center">
      <a href="https://line.me/R/ti/p/@sam6768c" target="_blank">
        <button type="button" class="primary-btn -solid">
          <span class="-text _fs18 _fw500">Free Consultation via LINE</span>
        </button>
      </a>
    </div>
  </section>
</Layout>
