---
import Layout from '../../layouts/Layout.astro';

const programs = [
  { title: 'Post-stroke Rehabilitation', desc: 'Intensive programs to restore mobility, speech, and daily function after stroke.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620375204_.jpg' },
  { title: 'Fall Prevention Program', desc: 'Balance training, strength building, and home safety assessment.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620377995_.jpg' },
  { title: 'Cognitive Stimulation', desc: 'Activities and exercises to preserve cognitive function in early dementia.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620375189_.jpg' },
  { title: 'Chronic Pain Management', desc: 'Specialized pain management for older adults with arthritis and chronic conditions.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620377943_.jpg' },
  { title: 'Post-surgical Recovery', desc: 'Recovery programs after joint replacement and other surgical procedures.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620446506_.jpg' },
  { title: 'Neurological Rehabilitation', desc: 'Rehabilitation for Parkinson\'s disease, hemiparesis, and other neurological conditions.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620375177_.jpg' },
];
---

<Layout
  title="Geriatric Rehabilitation Center - Chivacare Chiang Mai"
  description="Comprehensive rehabilitation programs for older adults: post-stroke recovery, fall prevention, cognitive stimulation, and caregiver support."
>
  <section class="page-banner" style="padding:120px 0 60px;background:#f7fafc;text-align:center;">
    <div class="container">
      <h1 style="color:#30c1b8;">Geriatric Rehabilitation Center</h1>
      <p>Specialized care for older adults to maintain independence and quality of life.</p>
    </div>
  </section>

  <section style="padding:60px 0;">
    <div class="container">
      <h2 style="color:#30c1b8;margin-bottom:30px;">Our Programs</h2>
      <div class="row">
        {programs.map((p) => (
          <div class="col-md-4 col-sm-6" style="margin-bottom:30px;">
            <img src={p.img} alt={p.title} class="img-responsive" style="border-radius:8px;margin-bottom:15px;" />
            <h4 style="color:#30c1b8;">{p.title}</h4>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="padding:60px 0;background:#f7fafc;">
    <div class="container text-center">
      <h3>Start Your Loved One's Journey to Recovery</h3>
      <p>Speak with our geriatric specialists today.</p>
      <a href="https://line.me/R/ti/p/@sam6768c" target="_blank" class="btn btn-primary btn-lg">Contact on Line</a>
    </div>
  </section>
</Layout>
