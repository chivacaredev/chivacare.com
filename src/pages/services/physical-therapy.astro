---
import Layout from '../../layouts/Layout.astro';

const conditions = [
  { title: 'Tennis Elbow (Lateral Epicondylitis)', desc: 'Manual therapy, shockwave, and exercise prescription to relieve lateral elbow pain.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620973383_.jpg' },
  { title: 'Carpal Tunnel Syndrome', desc: 'Conservative treatment for median nerve compression at the wrist.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620446495_.jpg' },
  { title: 'Frozen Shoulder', desc: 'Restoration of shoulder range of motion through targeted therapy.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620446506_.jpg' },
  { title: 'Hip Osteoarthritis', desc: 'Pain management and joint preservation for hip OA.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620377943_.jpg' },
  { title: 'Knee Osteoarthritis', desc: 'Comprehensive non-surgical management of knee OA.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620377995_.jpg' },
  { title: 'Degenerative Spine Disease', desc: 'Treatment for degenerative disc disease and chronic back pain.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620378034_.jpg' },
  { title: 'Office Syndrome', desc: 'Postural correction, manual therapy, and ergonomic coaching for desk workers.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620378076_.jpg' },
];
---

<Layout
  title="Physical & Occupational Therapy Clinic - Chivacare Chiang Mai"
  description="Treatment for office syndrome, chronic pain, joint conditions, and rehabilitation by licensed physical & occupational therapists."
>
  <section class="page-banner" style="padding:120px 0 60px;background:#f7fafc;text-align:center;">
    <div class="container">
      <h1 style="color:#30c1b8;">Physical & Occupational Therapy Clinic</h1>
      <p>Personalized rehabilitation programs for pain relief and functional recovery.</p>
    </div>
  </section>

  <section style="padding:60px 0;">
    <div class="container">
      <h2 style="color:#30c1b8;margin-bottom:30px;">Conditions We Treat</h2>
      <div class="row">
        {conditions.map((c) => (
          <div class="col-md-4 col-sm-6" style="margin-bottom:30px;">
            <img src={c.img} alt={c.title} class="img-responsive" style="border-radius:8px;margin-bottom:15px;" />
            <h4 style="color:#30c1b8;">{c.title}</h4>
            <p>{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="padding:60px 0;background:#f7fafc;">
    <div class="container text-center">
      <h3>Book a Consultation</h3>
      <p>Get a personalized assessment from our licensed therapists.</p>
      <a href="https://line.me/R/ti/p/@sam6768c" target="_blank" class="btn btn-primary btn-lg">Contact on Line</a>
    </div>
  </section>
</Layout>
