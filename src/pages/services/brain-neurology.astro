---
import Layout from '../../layouts/Layout.astro';

const conditions = [
  { name: 'Depression', desc: 'Emotional disorder affecting thoughts, feelings, and behavior. Treatable with TMS without medication.' },
  { name: 'Insomnia', desc: 'Difficulty falling or staying asleep. TMS stimulation provides drug-free deep sleep improvement.' },
  { name: 'Cerebrovascular Disease & Stroke', desc: 'Brain blood vessel blockage or rupture causing tissue damage and paralysis. Rehabilitation with TMS.' },
  { name: 'Dementia & Alzheimer\'s', desc: 'Brain abnormalities affecting cognition and daily functioning. Early detection and management.' },
  { name: 'Parkinson\'s Disease', desc: 'Brain cell degeneration reducing dopamine. Specialized rehabilitation and movement therapy.' },
  { name: 'Migraines & Headaches', desc: 'Severe throbbing headaches with nausea. TMS and Shockwave for drug-free relief.' },
  { name: 'Peripheral Nerve Pain', desc: 'Numbness, tingling, and nerve-related pain. PMS electromagnetic stimulation for targeted relief.' },
];

const technologies = [
  {
    name: 'TMS',
    full: 'Transcranial Magnetic Stimulation',
    desc: 'Non-invasive brain stimulation using magnetic pulses. Used for depression, insomnia, stroke recovery, and migraine.',
    color: 'border-primary'
  },
  {
    name: 'PMS',
    full: 'Peripheral Magnetic Stimulation',
    desc: 'Electromagnetic stimulation for peripheral nerve pain, numbness, and muscle weakness.',
    color: 'border-secondary'
  },
  {
    name: 'Shockwave',
    full: 'Swiss Doloclast® Shockwave',
    desc: 'High-energy pressure waves targeting chronic pain at the source. Effective for migraines linked to office syndrome.',
    color: 'border-[#5fa8d3]'
  },
  {
    name: 'NCV-EMG',
    full: 'Nerve Conduction & EMG Testing',
    desc: 'Advanced diagnostic testing for nerve conduction velocity and muscle function evaluation.',
    color: 'border-primary'
  },
];
---

<Layout title="Brain and Neurology Clinic">
  <!-- Hero -->
  <section class="relative py-28 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/category-brain.jpg" alt="Brain and Neurology Clinic" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-primary/75"></div>
    </div>
    <div class="section-container relative z-10 text-center text-white">
      <span class="text-secondary font-extrabold uppercase tracking-[0.2em] text-[13px]">Specialized Care</span>
      <h1 class="text-[36px] md:text-[56px] font-bold mt-4 mb-6">Brain and Neurology Clinic</h1>
      <p class="text-[18px] opacity-90 max-w-3xl mx-auto">
        Founded in 2016 by Assoc. Prof. Dr. Surat Tanprawet. Comprehensive neurological diagnosis and treatment in Chiang Mai.
      </p>
    </div>
  </section>

  <!-- About -->
  <section class="py-20 bg-white">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
          <span class="text-secondary font-extrabold uppercase tracking-[0.2em] text-[13px]">Our Expertise</span>
          <h2 class="text-[30px] md:text-[40px] font-bold text-primary leading-tight">Conditions We Treat</h2>
          <p class="text-[17px] leading-relaxed text-text-body">
            Our clinic provides expert care for a wide range of brain and nervous system disorders, focusing on improving quality of life through modern, evidence-based treatment.
          </p>
          <ul class="space-y-4">
            {conditions.map(c => (
              <li class="flex items-start gap-4 p-4 bg-accent rounded-xl hover:shadow-chiva transition-all">
                <span class="text-secondary font-bold text-xl mt-0.5 flex-shrink-0">✓</span>
                <div>
                  <span class="font-bold text-primary">{c.name}</span>
                  <p class="text-[14px] text-text-body mt-1">{c.desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div class="relative">
          <div class="absolute -top-6 -right-6 w-full h-full border-2 border-secondary/30 rounded-3xl z-0"></div>
          <img src="/images/service-1.jpg" alt="Brain Clinic Treatment" class="w-full rounded-3xl shadow-2xl relative z-10 object-cover aspect-[4/3]" />
        </div>
      </div>
    </div>
  </section>

  <!-- Technologies -->
  <section class="py-20 bg-accent">
    <div class="section-container">
      <div class="text-center mb-14">
        <span class="text-secondary font-extrabold uppercase tracking-[0.2em] text-[13px]">Innovation</span>
        <h2 class="text-[28px] md:text-[38px] font-bold text-primary mt-3">Advanced Medical Technology</h2>
        <div class="w-24 h-1.5 bg-secondary mx-auto rounded-full mt-5"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {technologies.map(t => (
          <div class={`bg-white p-8 rounded-2xl shadow-chiva hover:-translate-y-2 hover:shadow-chiva-hover transition-all border-t-4 ${t.color}`}>
            <div class="text-[28px] font-black text-primary mb-1">{t.name}</div>
            <div class="text-[12px] font-bold text-secondary uppercase tracking-wide mb-4">{t.full}</div>
            <p class="text-text-body text-[14px] leading-relaxed">{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Service images -->
  <section class="py-20 bg-white">
    <div class="section-container">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <img src="/images/service-1.jpg" alt="Brain Clinic Service" class="w-full rounded-2xl shadow-chiva object-cover aspect-video" />
        <img src="/images/service-2.jpg" alt="Neurology Treatment" class="w-full rounded-2xl shadow-chiva object-cover aspect-video" />
        <img src="/images/service-4.jpg" alt="TMS Therapy" class="w-full rounded-2xl shadow-chiva object-cover aspect-video" />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-primary text-white text-center">
    <div class="section-container space-y-8">
      <h2 class="text-[28px] md:text-[38px] font-bold">Consult with our Neurology Specialists</h2>
      <p class="opacity-90 max-w-2xl mx-auto text-[17px]">Take the first step towards better brain health. Our specialists are ready to help.</p>
      <div class="flex flex-wrap gap-5 justify-center">
        <a href="/contact" class="chiva-btn bg-white text-primary hover:bg-secondary hover:text-white !px-10 !py-4 text-[17px]">Make an Appointment</a>
        <a href="/rates/brain-clinic" class="chiva-btn border-2 border-white text-white hover:bg-white hover:text-primary !px-10 !py-4 text-[17px]">View Rates</a>
      </div>
    </div>
  </section>
</Layout>
