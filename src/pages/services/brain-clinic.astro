---
import Layout from '../../layouts/Layout.astro';

const conditions = [
  { title: 'Depression', desc: 'A mood disorder marked by persistent sadness affecting thoughts, feelings, and daily behavior.', img: 'https://chivacare.com/assets/uploads/img_services/main/1720844790_clip.jpg' },
  { title: 'Insomnia', desc: 'A condition where patients cannot fall asleep, have poor sleep quality, or take over 20 minutes to fall asleep.', img: 'https://chivacare.com/assets/uploads/img_services/main/1720844262_clip.jpg' },
  { title: 'Stroke', desc: 'Brain tissue damage caused by narrowed, blocked, or ruptured blood vessels disrupting brain function.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620375204_.jpg' },
  { title: 'Dementia', desc: 'A group of symptoms caused by disorders affecting the brain, impacting thinking, behavior, and daily activities.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620375189_.jpg' },
  { title: "Parkinson's Disease", desc: 'A degenerative brain disease where nerve cells die, reducing dopamine and causing movement difficulties.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620375177_.jpg' },
  { title: 'Migraine & Headache', desc: 'Severe headaches caused by abnormal constriction and dilation of arteries in the brain.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620374818_.jpg' },
];

const programs = [
  { title: 'Insomnia Treatment Without Medication', desc: 'TMS therapy as a safe alternative to sleep medication, stimulating the brain to restore natural sleep cycles.', img: 'https://chivacare.com/assets/uploads/img_services/main/1729570321_clip.jpg' },
  { title: 'Depression Treatment with TMS', desc: 'Electromagnetic wave therapy to treat depression — effective, non-invasive, and without the side effects of medication.', img: 'https://chivacare.com/assets/uploads/img_services/main/1720846193_clip.jpg' },
  { title: 'TMS for Insomnia', desc: 'Targeted TMS sessions to rewire sleep-regulating brain circuits and restore restful, natural sleep.', img: 'https://chivacare.com/assets/uploads/img_services/main/1720845769_clip.jpg' },
  { title: 'Botox Injection for Migraine', desc: 'Preventive botulinum toxin injections for chronic migraine — reduces frequency and severity of attacks.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620362240_.jpg' },
  { title: 'Migraine Injection Therapy', desc: 'Targeted injection therapy to rapidly relieve acute migraine episodes and reduce recurrence.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620362166_.jpg' },
  { title: 'TMS Electromagnetic Treatment', desc: 'Non-invasive brain stimulation using focused magnetic pulses to treat neurological and psychiatric conditions.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620362090_.jpg' },
  { title: "Parkinson's Rehabilitation Program", desc: 'Combined physiotherapy, occupational therapy, and medical management to maintain function and quality of life.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620361973_.jpg' },
  { title: 'Cerebrovascular Recovery Program', desc: 'Structured rehabilitation for patients recovering from stroke, cerebrovascular narrowing, or ischemic events.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620361914_.jpg' },
  { title: 'Dementia Rehabilitation Program', desc: 'Cognitive stimulation, memory training, and caregiver support designed for patients with dementia.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620375189_.jpg' },
  { title: 'tDCS Brain Stimulation Therapy', desc: 'Transcranial direct current stimulation to enhance neuroplasticity and support recovery from brain conditions.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620362090_.jpg' },
];

const assessments = [
  { title: 'Cognitive Self-Assessment', desc: 'Screen for early signs of memory problems, dementia, or cognitive decline.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620362384_.jpg', link: '/assessment' },
  { title: 'Stress & Mental Health Assessment', desc: 'Evaluate your stress level and mental wellbeing with a validated self-report tool.', img: 'https://chivacare.com/assets/uploads/img_services/main/1620362337_.jpg', link: '/assessment' },
];
---

<Layout
  title="Brain & Nervous System Clinic - Chivacare Chiang Mai"
  description="Specialist clinic for migraine, stroke, depression, insomnia, dementia, Parkinson's, and other neurological conditions."
>
  <!-- Breadcrumb -->
  <div class="container" style="padding-top:80px;">
    <ol class="breadcrumb" style="background:transparent;padding-left:0;">
      <li><a href="/">Home</a></li>
      <li><a href="javascript:;">Our Services</a></li>
      <li class="active">Brain &amp; Nervous System Clinic</li>
    </ol>
  </div>

  <!-- Intro -->
  <section style="padding:20px 0 40px;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="head-title">
          <h1 class="title -animated-underline -show-line scrollanimation animated fadeInDown" style="font-size:28px;">Brain &amp; Nervous System Clinic</h1>
        </div>
        <p style="margin-top:20px;">The Brain Clinic, a branch of Chivacare, was founded in 2016 by Asst. Prof. Dr. Surat Tanprawate. The clinic provides professional diagnosis, investigation, and treatment for a wide range of brain and nervous system disorders — including dementia, Alzheimer's disease, migraine, Parkinson's disease, cerebrovascular disease, stroke rehabilitation, and hemiparesis recovery.</p>
      </div>
    </div>
  </section>

  <!-- Conditions We Treat -->
  <section style="padding:20px 0 40px;background:#f7fafc;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="head-title">
          <h2 class="title -animated-underline -show-line scrollanimation animated fadeInDown">Brain &amp; Nervous System Conditions We Treat</h2>
        </div>
        <div class="row" style="margin-top:32px;">
          {conditions.map((c) => (
            <div class="col-md-4 col-sm-6" style="margin-bottom:24px;">
              <div class="content-wrapper _h-100pct _dp-f _fdrt-cl has-background-white _bsd-default _bdrd-4px">
                <img class="img-responsive" src={c.img} alt={c.title} style="width:100%;height:200px;object-fit:cover;border-radius:4px 4px 0 0;" />
                <div style="padding:16px;flex:1;">
                  <h4 style="color:#30c1b8;">{c.title}</h4>
                  <p>{c.desc}</p>
                  <a href="/assessment" style="color:#30c1b8;">Details &rarr;</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Treatment Programs -->
  <section style="padding:40px 0;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="head-title">
          <h2 class="title -animated-underline -show-line scrollanimation animated fadeInDown">Treatment Programs at Chivacare</h2>
        </div>
        <div class="row" style="margin-top:32px;">
          {programs.map((p) => (
            <div class="col-md-4 col-sm-6" style="margin-bottom:24px;">
              <div class="content-wrapper _h-100pct _dp-f _fdrt-cl has-background-white _bsd-default _bdrd-4px">
                <img class="img-responsive" src={p.img} alt={p.title} style="width:100%;height:200px;object-fit:cover;border-radius:4px 4px 0 0;" />
                <div style="padding:16px;flex:1;">
                  <h4 style="color:#30c1b8;">{p.title}</h4>
                  <p>{p.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Self-Assessment -->
  <section style="padding:40px 0;background:#f7fafc;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="head-title">
          <h2 class="title -animated-underline -show-line scrollanimation animated fadeInDown">Self-Assessment</h2>
        </div>
        <div class="row" style="margin-top:32px;">
          {assessments.map((a) => (
            <div class="col-md-4 col-sm-6" style="margin-bottom:24px;">
              <div class="content-wrapper _h-100pct _dp-f _fdrt-cl has-background-white _bsd-default _bdrd-4px">
                <img class="img-responsive" src={a.img} alt={a.title} style="width:100%;height:200px;object-fit:cover;border-radius:4px 4px 0 0;" />
                <div style="padding:16px;flex:1;">
                  <h4 style="color:#30c1b8;">{a.title}</h4>
                  <p>{a.desc}</p>
                  <a href={a.link} class="btn btn-primary btn-sm" style="margin-top:8px;">Start Assessment</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding:48px 0;">
    <div class="container text-center">
      <a href="https://line.me/R/ti/p/@sam6768c" target="_blank">
        <button type="button" class="primary-btn -solid">
          <span class="-text _fs18 _fw500">Free Consultation via LINE</span>
        </button>
      </a>
    </div>
  </section>
</Layout>
