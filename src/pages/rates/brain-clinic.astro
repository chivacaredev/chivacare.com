---
import Layout from '../../layouts/Layout.astro';

const rates = [
  { category: 'Consultation & Diagnosis', items: [
    { name: 'Specialist Consultation', price: '800 - 1,500 THB' },
    { name: 'NCV-EMG (Nerve Conduction)', price: 'Starting from 3,500 THB' }
  ]},
  { category: 'TMS Treatment (Per Session)', items: [
    { name: 'Depression / Insomnia', price: '2,500 THB' },
    { name: 'Stroke Rehabilitation', price: '3,000 THB' },
    { name: 'Migraine Relief', price: '2,500 THB' }
  ]},
  { category: 'Packages', items: [
    { name: '5 Sessions TMS Package', price: '10% Discount' },
    { name: '10 Sessions TMS Package', price: '20% Discount' }
  ]}
];
---

<Layout title="Brain Clinic Rates">
  <section class="section bg-primary text-white text-center">
    <div class="container">
      <h1 class="text-white text-4xl font-bold mb-4">Service Rates: Brain Clinic</h1>
      <p class="text-xl opacity-90">Transparent pricing for our specialized neurological services.</p>
    </div>
  </section>

  <section class="section container max-w-4xl">
    <div class="space-y-12">
      {rates.map(group => (
        <div>
          <h2 class="text-2xl font-bold mb-6 border-b-2 border-secondary pb-2">{group.category}</h2>
          <div class="bg-white rounded-xl shadow-md overflow-hidden">
            <table class="w-full text-left">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-4 font-bold text-gray-700">Service</th>
                  <th class="px-6 py-4 font-bold text-gray-700 text-right">Price</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {group.items.map(item => (
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4 text-gray-600">{item.name}</td>
                    <td class="px-6 py-4 text-primary font-bold text-right">{item.price}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 p-6 bg-accent rounded-lg text-sm text-gray-600">
      <p>* Prices are subject to change based on specific medical needs and duration of consultation.</p>
      <p>* Please contact us for more accurate quotes and current promotion details.</p>
    </div>
  </section>

  <section class="section bg-gray-50">
    <div class="container text-center space-y-6">
      <h2 class="text-3xl font-bold">Need a precise quote?</h2>
      <p class="text-gray-600">Call us at +66 96-980-0126 or click below to message us.</p>
      <a href="/contact" class="btn btn-primary">Contact Us</a>
    </div>
  </section>
</Layout>
