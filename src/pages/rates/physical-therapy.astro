---
import Layout from '../../layouts/Layout.astro';

const rates = [
  { category: 'Physical Therapy Services', items: [
    { name: 'Initial Assessment & Treatment', price: '1,200 - 1,800 THB' },
    { name: 'Standard PT Session', price: '1,200 THB' },
    { name: 'Manual Therapy & Medical Massage', price: '1,000 - 1,500 THB' }
  ]},
  { category: 'Advanced Pain Relief', items: [
    { name: 'Shockwave Therapy (Per Area)', price: 'Starting from 1,500 THB' },
    { name: 'Dry Needling Session', price: '800 - 1,200 THB' },
    { name: 'High-Power Laser Therapy', price: '1,000 THB' },
    { name: 'Peripheral Magnetic Stimulation (PMS)', price: '1,500 THB' }
  ]},
  { category: 'Specialized Packages', items: [
    { name: 'Office Syndrome Relief (Shockwave + Stretch)', price: '1,500 THB' },
    { name: 'Intensive Pain Treatment Bundle', price: '2,500 - 3,500 THB' },
    { name: 'Home Visit Rehabilitation', price: 'Starting from 2,500 THB' }
  ]}
];
---

<Layout title="Physical Therapy Rates">
  <section class="section bg-secondary text-white text-center">
    <div class="container">
      <h1 class="text-white text-4xl font-bold mb-4">Service Rates: Physical Therapy</h1>
      <p class="text-xl opacity-90">Effective rehabilitation and pain relief at affordable rates.</p>
    </div>
  </section>

  <section class="section container max-w-4xl">
    <div class="space-y-12">
      {rates.map(group => (
        <div>
          <h2 class="text-2xl font-bold mb-6 border-b-2 border-primary pb-2">{group.category}</h2>
          <div class="bg-white rounded-xl shadow-md overflow-hidden">
            <table class="w-full text-left">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-4 font-bold text-gray-700">Service</th>
                  <th class="px-6 py-4 font-bold text-gray-700 text-right">Price</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {group.items.map(item => (
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4 text-gray-600">{item.name}</td>
                    <td class="px-6 py-4 text-secondary font-bold text-right">{item.price}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 p-6 bg-accent rounded-lg text-sm text-gray-600">
      <p>* Prices are subject to change based on the specific areas treated and duration of therapy.</p>
      <p>* Home visit rates depend on the distance from Chiang Mai city limits.</p>
    </div>
  </section>

  <section class="section bg-gray-50">
    <div class="container text-center space-y-6">
      <h2 class="text-3xl font-bold">Ready to start your therapy?</h2>
      <p class="text-gray-600">Consult with our therapists to find the best plan for you.</p>
      <a href="/contact" class="btn btn-primary">Book an Appointment</a>
    </div>
  </section>
</Layout>
