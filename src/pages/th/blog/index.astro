---
import LayoutTh from '../../../layouts/LayoutTh.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog-th')).sort((a, b) => b.data.id - a.data.id);
const categories = ['ทั้งหมด', 'สมองและระบบประสาท', 'กายภาพบำบัด', 'สุขภาพจิต', 'การฟื้นฟู', 'กิจกรรมบำบัด'];
---

<LayoutTh
  title="สาระน่ารู้ - ชีวาแคร์ เชียงใหม่"
  description="บทความสุขภาพจากผู้เชี่ยวชาญชีวาแคร์ด้านสมอง สุขภาพจิต กายภาพบำบัด การฟื้นฟู และการดูแลผู้สูงอายุ"
>
  <div class="container" style="padding-top:80px;">
    <ol class="breadcrumb" style="background:transparent;padding-left:0;">
      <li><a href="/th">หน้าหลัก</a></li>
      <li><a href="javascript:;">ข่าวสารและบทความ</a></li>
      <li class="active">สาระน่ารู้</li>
    </ol>
  </div>

  <section style="padding:20px 0 8px;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="head-title">
          <h1 class="title -animated-underline -show-line scrollanimation animated fadeInDown" style="font-size:28px;">สาระน่ารู้</h1>
        </div>
        <p style="margin-top:12px;color:#666;">ความรู้จากผู้เชี่ยวชาญชีวาแคร์ด้านสุขภาพสมอง โรคทางระบบประสาท กายภาพบำบัด และการฟื้นฟู</p>
      </div>
    </div>
  </section>

  <section style="padding:0 0 8px;background:#f7fafc;border-bottom:1px solid #e8edf2;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12" style="padding-top:16px;padding-bottom:8px;">
        {categories.map((cat) => (
          <button class="cat-filter-btn" data-cat={cat}
            style="margin:4px 6px 4px 0;padding:6px 16px;border-radius:20px;border:1px solid #30c1b8;background:white;color:#30c1b8;cursor:pointer;font-size:0.85em;transition:all 0.2s;">
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <section style="padding:28px 0 48px;background:#f7fafc;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="row" id="posts-grid">
          {posts.map((p) => (
            <div class="col-md-4 col-sm-6 post-card" style="margin-bottom:24px;" data-cat={p.data.category}>
              <div class="content-wrapper _h-100pct _dp-f _fdrt-cl has-background-white _bsd-default _bdrd-4px">
                <a href={`/th/blog/${p.data.id}`} style="display:block;overflow:hidden;border-radius:4px 4px 0 0;">
                  <img class="img-responsive" src={p.data.img} alt={p.data.title}
                    style="width:100%;height:200px;object-fit:cover;transition:transform 0.3s;" />
                </a>
                <div style="padding:16px;flex:1;display:flex;flex-direction:column;">
                  <p style="color:#30c1b8;font-size:0.82em;margin-bottom:6px;font-weight:500;">{p.data.category}</p>
                  <h4 style="font-size:15px;line-height:1.4;margin-bottom:8px;">
                    <a href={`/th/blog/${p.data.id}`} style="color:#222;text-decoration:none;">{p.data.title}</a>
                  </h4>
                  <p style="color:#666;font-size:0.88em;flex:1;line-height:1.5;">{p.data.description}</p>
                  <a href={`/th/blog/${p.data.id}`} class="btn-wrapper has-text-blue-primary" style="margin-top:12px;">
                    <span class="-text">อ่านเพิ่มเติม &rarr;</span>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div id="no-results" style="display:none;text-align:center;padding:40px;color:#888;">ไม่พบบทความในหมวดนี้</div>
      </div>
    </div>
  </section>
</LayoutTh>

<style>
  .cat-filter-btn.active, .cat-filter-btn:hover { background:#30c1b8!important;color:white!important; }
</style>

<script is:inline>
(function(){
  var btns=document.querySelectorAll('.cat-filter-btn');
  var cards=document.querySelectorAll('.post-card');
  var noRes=document.getElementById('no-results');
  function filterBy(cat){
    btns.forEach(function(b){b.classList.toggle('active',b.dataset.cat===cat);});
    var v=0;
    cards.forEach(function(c){var s=cat==='ทั้งหมด'||c.dataset.cat===cat;c.style.display=s?'':'none';if(s)v++;});
    noRes.style.display=v===0?'block':'none';
  }
  btns.forEach(function(b){b.addEventListener('click',function(){filterBy(b.dataset.cat);});});
  var p=new URLSearchParams(window.location.search);
  filterBy(p.get('cat')||'ทั้งหมด');
})();
</script>
