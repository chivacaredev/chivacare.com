---
import Layout from '../../layouts/Layout.astro';

const newsItems = [
  {
    date: 'May 10, 2026',
    title: 'New Service: Swallowing & Speech Rehabilitation',
    desc: 'Our occupational therapists now offer specialized care for patients with tongue stiffness and swallowing difficulties.',
    type: 'Update'
  },
  {
    date: 'May 5, 2026',
    title: 'Advanced Pain Relief Program Expanded',
    desc: 'We have integrated the latest PMS technology to better serve patients with chronic numbness and nerve pain.',
    type: 'Clinic News'
  },
  {
    date: 'April 28, 2026',
    title: 'Community Health Talk: Preventing Alzheimer’s',
    desc: 'Asst. Prof. Dr. Surat Tanprawet shared insights on brain training apps and lifestyle changes for brain health.',
    type: 'Event'
  },
  {
    date: 'April 20, 2026',
    title: 'Migraine Innovation: Drug-Free TMS Treatment',
    desc: 'Our latest study shows significant reduction in migraine frequency for patients using TMS therapy.',
    type: 'Innovation'
  }
];
---

<Layout title="News & Activities">
  <section class="section bg-primary text-white text-center">
    <div class="container">
      <h1 class="text-white text-4xl md:text-5xl font-bold mb-4">News & Activities</h1>
      <p class="text-xl opacity-90 max-w-2xl mx-auto">Stay updated with the latest events, clinic news, and health innovations from ChivaCare.</p>
    </div>
  </section>

  <section class="section container max-w-5xl">
    <div class="space-y-12">
      {newsItems.map(item => (
        <div class="flex flex-col md:flex-row gap-8 bg-white p-8 rounded-2xl shadow-lg border border-gray-50 hover:border-secondary transition-all">
          <div class="md:w-1/4">
            <span class="text-sm font-bold text-secondary uppercase tracking-widest">{item.date}</span>
            <div class="mt-2 inline-block px-3 py-1 bg-accent text-primary text-[10px] font-bold rounded-full uppercase">
              {item.type}
            </div>
          </div>
          <div class="md:w-3/4 space-y-4">
            <h2 class="text-2xl font-bold hover:text-primary cursor-pointer transition-colors leading-tight">{item.title}</h2>
            <p class="text-gray-600 leading-relaxed">{item.desc}</p>
            <a href="#" class="inline-flex items-center gap-2 text-primary font-bold text-sm hover:underline">
              Read More <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section bg-accent text-center">
    <div class="container space-y-8">
      <h2 class="text-3xl font-bold">Never miss an update</h2>
      <p class="text-gray-600 max-w-xl mx-auto">Subscribe to our monthly newsletter for the latest health tips and clinic announcements.</p>
      <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
        <input type="email" placeholder="Your email address" class="flex-grow px-6 py-3 rounded-lg border border-gray-200 focus:outline-none focus:border-primary" />
        <button type="submit" class="btn btn-primary">Subscribe</button>
      </form>
    </div>
  </section>
</Layout>
