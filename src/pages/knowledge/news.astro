---
import Layout from '../../layouts/Layout.astro';

const newsItems = [
  {
    date: 'May 10, 2025',
    title: 'New Service: Swallowing & Speech Rehabilitation',
    desc: 'Our occupational therapists now offer specialized care for patients with tongue stiffness and swallowing difficulties following stroke or neurological conditions.',
    type: 'Update'
  },
  {
    date: 'April 22, 2025',
    title: 'Advanced Pain Relief Program Expanded',
    desc: 'We have integrated the latest PMS technology to better serve patients with chronic numbness and nerve pain. The expanded program now includes enhanced peripheral nerve protocols.',
    type: 'Clinic News'
  },
  {
    date: 'March 15, 2025',
    title: 'Community Health Talk: Preventing Alzheimer\'s Disease',
    desc: 'Assoc. Prof. Dr. Surat Tanprawet shared insights on brain training, lifestyle interventions, and early screening for brain health at a community seminar in Chiang Mai.',
    type: 'Event'
  },
  {
    date: 'February 8, 2025',
    title: 'Migraine Innovation: Drug-Free TMS Treatment',
    desc: 'Our latest patient outcomes data shows significant reduction in migraine frequency for patients completing the full TMS program. Patients report fewer attacks and reduced medication dependence.',
    type: 'Innovation'
  },
  {
    date: 'January 20, 2025',
    title: 'ChivaCare Now Offers Geriatric Home Assessment',
    desc: 'Our geriatric rehabilitation team can now conduct home visits to assess fall risk, mobility, and daily living safety for elderly patients in the Chiang Mai area.',
    type: 'New Service'
  },
  {
    date: 'December 5, 2024',
    title: 'New TMS Protocol for Parkinson\'s Disease',
    desc: 'Following encouraging clinical results, ChivaCare has introduced a specialized TMS protocol for Parkinson\'s disease patients targeting gait improvement and tremor reduction.',
    type: 'Innovation'
  },
  {
    date: 'November 12, 2024',
    title: 'Workshop: Understanding Stroke Recovery for Families',
    desc: 'Our rehabilitation team hosted a workshop for families of stroke patients, covering rehabilitation goals, home exercise programs, and caregiver wellness.',
    type: 'Event'
  },
  {
    date: 'October 3, 2024',
    title: 'Swiss Doloclast Shockwave Recertification Completed',
    desc: 'Our physical therapy team has completed advanced recertification training in Swiss Doloclast® shockwave technique, ensuring the highest standard of care for all shockwave patients.',
    type: 'Training'
  },
];

const typeColors: Record<string, string> = {
  'Update': 'bg-primary/10 text-primary',
  'Clinic News': 'bg-secondary/20 text-primary',
  'Event': 'bg-[#5fa8d3]/15 text-[#3a7a9c]',
  'Innovation': 'bg-secondary/30 text-primary',
  'New Service': 'bg-primary/10 text-primary',
  'Training': 'bg-accent text-text-body',
};
---

<Layout title="News & Activities">
  <!-- Hero -->
  <section class="py-20 md:py-28 bg-primary text-white text-center">
    <div class="section-container">
      <span class="text-secondary font-extrabold uppercase tracking-[0.2em] text-[13px]">Latest from ChivaCare</span>
      <h1 class="text-[36px] md:text-[52px] font-bold mt-4 mb-6">News & Activities</h1>
      <p class="text-[18px] opacity-90 max-w-2xl mx-auto leading-relaxed">
        Stay updated with the latest events, clinic news, and health innovations from ChivaCare.
      </p>
    </div>
  </section>

  <!-- News Items -->
  <section class="py-20 bg-white">
    <div class="section-container">
      <div class="max-w-4xl mx-auto space-y-8">
        {newsItems.map(item => (
          <div class="flex flex-col md:flex-row gap-8 bg-white p-8 rounded-2xl shadow-chiva border border-gray-100 hover:border-secondary/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-chiva-hover">
            <div class="md:w-1/4 flex-shrink-0">
              <span class="text-[13px] font-bold text-secondary">{item.date}</span>
              <div class={`mt-2 inline-block px-3 py-1 text-[11px] font-bold rounded-full uppercase tracking-wide ${typeColors[item.type] ?? 'bg-accent text-primary'}`}>
                {item.type}
              </div>
            </div>
            <div class="md:w-3/4 space-y-3">
              <h2 class="text-[20px] font-bold text-primary leading-tight">{item.title}</h2>
              <p class="text-text-body leading-relaxed text-[15px]">{item.desc}</p>
              <a href="/contact" class="inline-flex items-center gap-2 text-secondary font-bold text-[14px] hover:underline pt-1">
                Learn More <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Social CTA -->
  <section class="py-20 bg-accent text-center">
    <div class="section-container space-y-8">
      <span class="text-secondary font-extrabold uppercase tracking-[0.2em] text-[13px]">Stay Connected</span>
      <h2 class="text-[28px] md:text-[36px] font-bold text-primary">Never Miss an Update</h2>
      <p class="text-text-body max-w-xl mx-auto text-[17px]">Follow us on social media for the latest clinic news, health tips, and upcoming events.</p>
      <div class="flex flex-wrap justify-center gap-5">
        <a href="https://www.facebook.com/ChivaCareInfo/" target="_blank" rel="noopener" class="chiva-btn chiva-btn-primary !px-8 !py-3">
          Facebook
        </a>
        <a href="https://www.youtube.com/@chivacare" target="_blank" rel="noopener" class="chiva-btn chiva-btn-outline !px-8 !py-3">
          YouTube
        </a>
      </div>
    </div>
  </section>
</Layout>
