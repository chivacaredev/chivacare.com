---
import Layout from '../../../layouts/Layout.astro';
import { articles } from '../../../data/articles';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const related = articles.filter((a) => a.slug !== article.slug).slice(0, 3);
---

<Layout title={article.title}>
  <!-- Hero -->
  <section class="relative h-[400px] overflow-hidden">
    <img src={article.image} alt={article.title} class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-primary/75"></div>
    <div class="relative z-10 h-full flex flex-col items-center justify-center text-center text-white px-4">
      <span class="bg-secondary text-white text-[12px] font-extrabold uppercase tracking-widest px-4 py-1.5 rounded-full mb-5">
        {article.tag}
      </span>
      <h1 class="text-[28px] md:text-[44px] font-bold max-w-3xl leading-tight">{article.title}</h1>
      <p class="mt-4 opacity-80 text-[15px]">{article.date}</p>
    </div>
  </section>

  <!-- Article Content -->
  <section class="py-20 bg-white">
    <div class="max-w-[800px] mx-auto px-4">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-[13px] text-text-body mb-10">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span>/</span>
        <a href="/knowledge/health" class="hover:text-primary transition-colors">Health Knowledge</a>
        <span>/</span>
        <span class="text-primary font-medium">{article.title}</span>
      </nav>

      <!-- Article body -->
      <div class="article-body" set:html={article.content} />

      <!-- Back link -->
      <div class="mt-14 pt-8 border-t border-gray-100">
        <a href="/knowledge/health" class="chiva-btn chiva-btn-outline !px-8 !py-3 text-[15px]">
          ← Back to Health Knowledge
        </a>
      </div>
    </div>
  </section>

  <!-- Related Articles -->
  <section class="py-20 bg-accent">
    <div class="section-container">
      <div class="text-center mb-12">
        <span class="text-secondary font-extrabold uppercase tracking-[0.2em] text-[13px]">Keep Reading</span>
        <h2 class="text-[28px] md:text-[36px] font-bold text-primary mt-3">Related Articles</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {related.map((rel) => (
          <article class="chiva-card group flex flex-col">
            <div class="relative h-[200px] overflow-hidden">
              <img src={rel.image} alt={rel.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute top-4 left-4 bg-white/90 text-primary text-[11px] font-bold px-3 py-1 rounded-full shadow-sm">
                {rel.tag}
              </div>
            </div>
            <div class="p-7 flex flex-col flex-grow">
              <h3 class="text-[16px] font-bold mb-3 text-primary leading-snug group-hover:text-secondary transition-colors flex-grow">
                {rel.title}
              </h3>
              <a href={`/knowledge/articles/${rel.slug}`} class="text-secondary font-bold text-[14px] hover:underline inline-flex items-center gap-2 mt-4">
                Read Article <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-primary text-white text-center">
    <div class="section-container space-y-6">
      <h2 class="text-[28px] md:text-[36px] font-bold">Have Questions About Your Health?</h2>
      <p class="opacity-90 max-w-xl mx-auto text-[17px]">Our specialist team is ready to assess your condition and recommend the most appropriate treatment.</p>
      <div class="flex flex-wrap gap-5 justify-center pt-2">
        <a href="/contact" class="chiva-btn bg-white text-primary hover:bg-secondary hover:text-white !px-10 !py-4 text-[17px]">Book a Consultation</a>
        <a href="tel:+66969800126" class="chiva-btn border-2 border-white text-white hover:bg-white hover:text-primary !px-10 !py-4 text-[17px]">+66 96-980-0126</a>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .article-body h2 {
    font-size: 22px;
    font-weight: 700;
    color: #006d77;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .article-body p {
    color: #666666;
    line-height: 1.85;
    margin-bottom: 1.2rem;
    font-size: 17px;
  }
  .article-body ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.2rem;
    space-y: 0.5rem;
  }
  .article-body li {
    color: #666666;
    font-size: 16px;
    line-height: 1.7;
    margin-bottom: 0.4rem;
  }
  .article-body strong {
    color: #333333;
    font-weight: 700;
  }
</style>
