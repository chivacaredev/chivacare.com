---
import Layout from '../layouts/Layout.astro';

const promotions = [
  { title: 'Pain Relief Package', subtitle: 'Comprehensive pain management', price: '3,500 THB', img: 'https://chivacare.com/assets/images/promo-pain.jpg' },
  { title: 'Shockwave Therapy', subtitle: 'For chronic muscle pain', price: '2,500 THB', img: 'https://chivacare.com/assets/images/promo-shockwave.jpg' },
  { title: 'Intensive Pain Care', subtitle: 'Deep muscle treatment', price: '4,500 THB', img: 'https://chivacare.com/assets/images/promo-intensive.jpg' },
  { title: 'Deep Pain Package A', subtitle: 'For long-standing pain', price: '5,500 THB', img: 'https://chivacare.com/assets/images/promo-deep1.jpg' },
  { title: 'Deep Pain Package B', subtitle: 'Advanced pain treatment', price: '6,500 THB', img: 'https://chivacare.com/assets/images/promo-deep2.jpg' },
  { title: 'Dry Needling Therapy', subtitle: 'Trigger point release', price: '2,000 THB', img: 'https://chivacare.com/assets/images/promo-dryneedle.jpg' },
  { title: 'Depression Treatment Package', subtitle: 'TMS-based program', price: '25,000 THB', img: 'https://chivacare.com/assets/images/promo-depression.jpg' },
  { title: 'TMS Insomnia Package', subtitle: 'Non-medication insomnia treatment', price: '20,000 THB', img: 'https://chivacare.com/assets/images/promo-tms-sleep.jpg' },
  { title: 'Insomnia (No Medication)', subtitle: 'Sleep improvement program', price: '15,000 THB', img: 'https://chivacare.com/assets/images/promo-sleep.jpg' },
  { title: 'IV Therapy', subtitle: 'Vitamin & nutrient infusion', price: '2,500 THB', img: 'https://chivacare.com/assets/images/promo-iv.jpg' },
];
---

<Layout
  title="Promotions - Chivacare Chiang Mai"
  description="Special treatment packages and promotions at Chivacare - pain relief, TMS, IV therapy, and more."
>
  <section class="page-banner" style="padding:120px 0 60px;background:#f7fafc;text-align:center;">
    <div class="container">
      <h1 style="color:#30c1b8;">Promotions</h1>
      <p>Special treatment packages from our specialists.</p>
    </div>
  </section>

  <section style="padding:60px 0;">
    <div class="container">
      <div class="row">
        {promotions.map((p) => (
          <div class="col-md-4 col-sm-6" style="margin-bottom:30px;">
            <div style="background:#fff;border:1px solid #eee;border-radius:8px;overflow:hidden;height:100%;">
              <img src={p.img} alt={p.title} class="img-responsive" style="width:100%;height:220px;object-fit:cover;" />
              <div style="padding:20px;">
                <h4 style="color:#30c1b8;">{p.title}</h4>
                <p>{p.subtitle}</p>
                <p style="font-size:1.3em;font-weight:bold;color:#f5365c;">{p.price}</p>
                <a href="https://line.me/R/ti/p/@sam6768c" target="_blank" class="btn btn-primary btn-sm">Book Now</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
