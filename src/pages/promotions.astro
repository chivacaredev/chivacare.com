---
import Layout from '../layouts/Layout.astro';

const promotions = [
  { title: 'Pain Relief Program', subtitle: 'Comprehensive pain management program', img: 'https://chivacare.com/assets/uploads/img_services/main/1620378076_.jpg' },
  { title: 'Shockwave Program', subtitle: 'For chronic muscle and joint pain', img: 'https://chivacare.com/assets/uploads/img_services/main/1620973383_.jpg' },
  { title: 'Intensive Pain Treatment Program', subtitle: 'Deep pain treatment by specialists', img: 'https://chivacare.com/assets/uploads/img_services/main/1620377943_.jpg' },
  { title: 'Deep Pain & Muscle Tension Relief x 2', subtitle: 'Two-session deep muscle release', img: 'https://chivacare.com/assets/uploads/img_services/main/1620377995_.jpg' },
  { title: 'Dry Needling (Western Acupuncture)', subtitle: 'Pinpoint deep pain relief at the source', img: 'https://chivacare.com/assets/uploads/img_services/main/1620446495_.jpg' },
  { title: 'Depression Treatment Package', subtitle: 'Treat depression with TMS electromagnetic wave technology', img: 'https://chivacare.com/assets/uploads/img_services/main/1720844790_clip.jpg' },
  { title: 'TMS Program for Insomnia', subtitle: 'TMS technology stimulates the brain with electromagnetic waves', img: 'https://chivacare.com/assets/uploads/img_services/main/1720844262_clip.jpg' },
  { title: 'Insomnia Relief, No Medication Needed', subtitle: 'Non-pharmacological sleep improvement program', img: 'https://chivacare.com/assets/uploads/img_services/main/1620375189_.jpg' },
  { title: 'IV Therapy — Vitamin Drip', subtitle: 'Replenish vitamins for a stronger, healthier body', img: 'https://chivacare.com/assets/uploads/img_services/main/1620375204_.jpg' },
];
---

<Layout
  title="Promotions - Chivacare Chiang Mai"
  description="Special treatment packages and promotions at Chivacare - pain relief, TMS, IV therapy, and more."
>
  <section class="page-banner" style="padding:120px 0 60px;background:#f7fafc;text-align:center;">
    <div class="container">
      <h1 style="color:#30c1b8;">Promotions</h1>
      <p>Special treatment packages from our specialists.</p>
    </div>
  </section>

  <section style="padding:60px 0;">
    <div class="container">
      <div class="row">
        {promotions.map((p) => (
          <div class="col-md-4 col-sm-6" style="margin-bottom:30px;">
            <div style="background:#fff;border:1px solid #eee;border-radius:8px;overflow:hidden;height:100%;">
              <img src={p.img} alt={p.title} class="img-responsive" style="width:100%;height:220px;object-fit:cover;" />
              <div style="padding:20px;">
                <h4 style="color:#30c1b8;">{p.title}</h4>
                <p>{p.subtitle}</p>
                <a href="https://line.me/R/ti/p/@sam6768c" target="_blank" class="btn btn-primary btn-sm">Book Now</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
