---
import Layout from '../layouts/Layout.astro';

const promotions = [
  { title: 'Pain Relief Program', subtitle: 'Comprehensive pain management program combining multiple therapies for targeted relief.', img: 'https://chivacare.com/assets/uploads/img_promotions/main/1750671434_.jpg' },
  { title: 'Shockwave Program', subtitle: 'Shockwave therapy for chronic muscle and joint pain — stimulates tissue repair.', img: 'https://chivacare.com/assets/uploads/img_promotions/main/1750671343_clip.jpg' },
  { title: 'Intensive Pain Treatment Program', subtitle: 'Deep pain treatment by specialist rehabilitation physicians — effective and targeted.', img: 'https://chivacare.com/assets/uploads/img_promotions/main/1750671303_clip.jpg' },
  { title: 'Deep Pain & Muscle Tension Relief x 2', subtitle: 'Two-session deep muscle release program to dissolve tension and eliminate persistent pain.', img: 'https://chivacare.com/assets/uploads/img_promotions/main/1750671270_clip.jpg' },
  { title: 'Dry Needling (Western Acupuncture)', subtitle: 'Pinpoint deep pain relief at the source — performed by specialist physicians using the Western needle technique.', img: 'https://chivacare.com/assets/uploads/img_promotions/main/1750671229_clip.jpg' },
  { title: 'Depression Treatment Package', subtitle: 'Treat depression with TMS electromagnetic wave technology — no medication, no side effects.', img: 'https://chivacare.com/assets/uploads/img_promotions/main/1750671180_clip.jpg' },
  { title: 'TMS Program for Insomnia', subtitle: 'TMS technology stimulates the brain with electromagnetic waves to restore natural sleep patterns.', img: 'https://chivacare.com/assets/uploads/img_promotions/main/1750671106_clip.jpg' },
  { title: 'Insomnia Relief, No Medication Needed', subtitle: 'Overcome insomnia without sleeping pills — a safe, lasting, non-pharmacological program.', img: 'https://chivacare.com/assets/uploads/img_promotions/main/1750649404_clip.jpg' },
  { title: 'IV Therapy — Vitamin Drip', subtitle: 'Replenish vitamins and minerals directly into the bloodstream for immediate energy and wellness.', img: 'https://chivacare.com/assets/uploads/img_promotions/main/1750648234_clip.jpg' },
];
---

<Layout
  title="Promotions - Chivacare Chiang Mai"
  description="Special treatment packages and promotions at Chivacare — pain relief, TMS, IV therapy, shockwave, dry needling, and more."
>
  <!-- Breadcrumb -->
  <div class="container" style="padding-top:80px;">
    <ol class="breadcrumb" style="background:transparent;padding-left:0;">
      <li><a href="/">Home</a></li>
      <li class="active">Promotions</li>
    </ol>
  </div>

  <!-- Title -->
  <section style="padding:20px 0 20px;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="head-title">
          <h1 class="title -animated-underline -show-line scrollanimation animated fadeInDown" style="font-size:28px;">Promotions</h1>
        </div>
        <p style="margin-top:16px;">Special treatment packages from our specialist physicians and therapists. Contact us to book or ask for more details.</p>
      </div>
    </div>
  </section>

  <!-- Promotion Cards -->
  <section style="padding:20px 0 48px;background:#f7fafc;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="row">
          {promotions.map((p) => (
            <div class="col-md-4 col-sm-6" style="margin-bottom:24px;">
              <div class="content-wrapper _h-100pct _dp-f _fdrt-cl has-background-white _bsd-default _bdrd-4px">
                <img class="img-responsive" src={p.img} alt={p.title} style="width:100%;height:240px;object-fit:cover;border-radius:4px 4px 0 0;" />
                <div style="padding:16px;flex:1;display:flex;flex-direction:column;">
                  <h4 style="color:#30c1b8;">{p.title}</h4>
                  <p style="flex:1;">{p.subtitle}</p>
                  <a href="https://line.me/R/ti/p/@sam6768c" target="_blank" class="btn btn-primary btn-sm" style="margin-top:10px;">Book Now</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
