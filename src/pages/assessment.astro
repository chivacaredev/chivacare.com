---
import Layout from '../layouts/Layout.astro';

const assessments = [
  {
    title: 'GAD-7 Anxiety Assessment',
    desc: 'A 7-item screening tool to assess whether you may be experiencing symptoms of generalized anxiety disorder.',
    img: 'https://chivacare.com/assets/uploads/img_assessment/1735290249_img_assessment.png',
    link: 'https://chivacare.com/th/assessment/form/6',
  },
  {
    title: 'SPST-20 Stress Assessment',
    desc: 'Evaluate your current stress level using the SPST-20 validated stress self-assessment questionnaire.',
    img: 'https://chivacare.com/assets/uploads/img_assessment/1735290259_img_assessment.png',
    link: 'https://chivacare.com/th/assessment/form/5',
  },
  {
    title: 'Bipolar Mood Assessment',
    desc: 'A self-assessment to help identify mood patterns that may indicate bipolar disorder — for awareness purposes only.',
    img: 'https://chivacare.com/assets/uploads/img_assessment/1735290279_img_assessment.png',
    link: 'https://chivacare.com/th/assessment/form/4',
  },
  {
    title: 'Insomnia Severity Assessment',
    desc: 'Assess the severity of your sleep difficulties and their impact on your daily life and functioning.',
    img: 'https://chivacare.com/assets/uploads/img_assessment/1735290300_img_assessment.png',
    link: 'https://chivacare.com/th/assessment/form/3',
  },
  {
    title: 'PHQ-9 Depression Assessment',
    desc: 'A 9-item screening tool to check whether you may be experiencing symptoms of depression.',
    img: 'https://chivacare.com/assets/uploads/img_assessment/1721618170_img_assessment.png',
    link: 'https://chivacare.com/th/assessment/form/2',
  },
];
---

<Layout
  title="Self-Assessment - Chivacare Chiang Mai"
  description="Free online self-assessments for anxiety, stress, depression, insomnia, and bipolar mood. Results are not a diagnosis — consult a specialist."
>
  <!-- Breadcrumb -->
  <div class="container" style="padding-top:80px;">
    <ol class="breadcrumb" style="background:transparent;padding-left:0;">
      <li><a href="/">Home</a></li>
      <li class="active">Self-Assessment</li>
    </ol>
  </div>

  <!-- Title -->
  <section style="padding:20px 0 20px;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="head-title">
          <h1 class="title -animated-underline -show-line scrollanimation animated fadeInDown" style="font-size:28px;">Self-Assessment Tools</h1>
        </div>
        <p style="margin-top:16px;">Take a free screening test to better understand your health. These tools are for awareness purposes only — results are not a diagnosis. Please consult our specialists for a proper evaluation.</p>
      </div>
    </div>
  </section>

  <!-- Assessment Cards -->
  <section style="padding:20px 0 48px;background:#f7fafc;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="row">
          {assessments.map((a) => (
            <div class="col-md-4 col-sm-6" style="margin-bottom:24px;">
              <div class="content-wrapper _h-100pct _dp-f _fdrt-cl has-background-white _bsd-default _bdrd-4px">
                <img class="img-responsive" src={a.img} alt={a.title} style="width:100%;height:200px;object-fit:cover;border-radius:4px 4px 0 0;" />
                <div style="padding:16px;flex:1;display:flex;flex-direction:column;">
                  <h4 style="color:#30c1b8;">{a.title}</h4>
                  <p style="flex:1;">{a.desc}</p>
                  <a href={a.link} target="_blank" class="btn btn-primary btn-sm" style="margin-top:10px;">Start Assessment</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
