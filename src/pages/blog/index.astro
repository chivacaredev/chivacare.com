---
import Layout from '../../layouts/Layout.astro';
import { blogPosts } from '../../data/blogPosts';

const categories = ['All', 'Brain & Nervous System', 'Physical Therapy', 'Mental Health', 'Rehabilitation', 'Occupational Therapy'];
---

<Layout
  title="Health Articles - Chivacare Chiang Mai"
  description="Health articles on brain conditions, mental health, physical therapy, rehabilitation, and geriatric care from Chivacare specialists."
>
  <!-- Breadcrumb -->
  <div class="container" style="padding-top:80px;">
    <ol class="breadcrumb" style="background:transparent;padding-left:0;">
      <li><a href="/">Home</a></li>
      <li><a href="javascript:;">News &amp; Articles</a></li>
      <li class="active">Health Articles</li>
    </ol>
  </div>

  <!-- Title -->
  <section style="padding:20px 0 20px;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="head-title">
          <h1 class="title -animated-underline -show-line scrollanimation animated fadeInDown" style="font-size:28px;">Health Articles</h1>
        </div>
        <p style="margin-top:12px;color:#666;">Expert knowledge from Chivacare's specialists on brain health, neurological conditions, physical therapy, and rehabilitation.</p>
      </div>
    </div>
  </section>

  <!-- Category Filters -->
  <section style="padding:0 0 8px;background:#f7fafc;border-bottom:1px solid #e8edf2;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12" style="padding-top:16px;padding-bottom:8px;">
        {categories.map((cat) => (
          <button
            class="cat-filter-btn"
            data-cat={cat}
            style="margin:4px 6px 4px 0;padding:6px 16px;border-radius:20px;border:1px solid #30c1b8;background:white;color:#30c1b8;cursor:pointer;font-size:0.85em;transition:all 0.2s;"
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Article Grid -->
  <section style="padding:28px 0 48px;background:#f7fafc;">
    <div class="container _pdvrm-15px">
      <div class="col-md-12 col-sm-12">
        <div class="row" id="posts-grid">
          {blogPosts.map((p) => (
            <div class="col-md-4 col-sm-6 post-card" style="margin-bottom:24px;" data-cat={p.category}>
              <div class="content-wrapper _h-100pct _dp-f _fdrt-cl has-background-white _bsd-default _bdrd-4px">
                <a href={`/blog/${p.id}`} style="display:block;overflow:hidden;border-radius:4px 4px 0 0;">
                  <img class="img-responsive" src={p.img} alt={p.title} style="width:100%;height:200px;object-fit:cover;transition:transform 0.3s;" />
                </a>
                <div style="padding:16px;flex:1;display:flex;flex-direction:column;">
                  <p style="color:#30c1b8;font-size:0.82em;margin-bottom:6px;font-weight:500;">{p.category}</p>
                  <h4 style="font-size:15px;line-height:1.4;margin-bottom:8px;">
                    <a href={`/blog/${p.id}`} style="color:#222;text-decoration:none;">{p.title}</a>
                  </h4>
                  <p style="color:#666;font-size:0.88em;flex:1;line-height:1.5;">{p.description}</p>
                  <a href={`/blog/${p.id}`} class="btn-wrapper has-text-blue-primary" style="margin-top:12px;">
                    <span class="-text">Read more &rarr;</span>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div id="no-results" style="display:none;text-align:center;padding:40px;color:#888;">
          No articles found in this category.
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .cat-filter-btn.active,
  .cat-filter-btn:hover {
    background: #30c1b8 !important;
    color: white !important;
  }
  .content-wrapper:hover img {
    transform: scale(1.04);
  }
</style>

<script is:inline>
  (function () {
    var btns = document.querySelectorAll('.cat-filter-btn');
    var cards = document.querySelectorAll('.post-card');
    var noResults = document.getElementById('no-results');

    function filterBy(cat) {
      btns.forEach(function (b) {
        b.classList.toggle('active', b.dataset.cat === cat);
      });
      var visible = 0;
      cards.forEach(function (card) {
        var show = cat === 'All' || card.dataset.cat === cat;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      noResults.style.display = visible === 0 ? 'block' : 'none';
    }

    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        filterBy(btn.dataset.cat);
      });
    });

    var params = new URLSearchParams(window.location.search);
    var initCat = params.get('cat') || 'All';
    filterBy(initCat);
  })();
</script>
