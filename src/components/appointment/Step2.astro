---
/** Step 2 — choose a physician (legacy appointment/views/step2). */
import Wizard from './Wizard.astro';
import RadioCard from './RadioCard.astro';
import NavButtons from './NavButtons.astro';
import FieldError from './FieldError.astro';
import Carousel from '../Carousel.astro';
import { getTeamGroups, getTeams, img } from '../../lib/db';
import { pick, url, type Lang } from '../../lib/i18n';
import { W } from './strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = W[lang];

// Legacy fetchTeamsAll(): status A, id ASC, filtered by ?group (default 1).
// A static page cannot filter on the server, so every group is rendered and the script shows one.
const groups = getTeamGroups()
  .map((g) => ({ id: String(g.id), teams: getTeams().filter((t) => String(t.category_id) === String(g.id)) }))
  .filter((g) => g.teams.length > 0);
---

<Wizard lang={lang} step={2}>
  <form id="appt-step2" novalidate>
    <fieldset class="group" data-field="is_physician">
      <legend><h5 class="text-lg">{s.choosePhysician}</h5></legend>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <RadioCard name="is_physician" value="1" label={s.pickForMe}>
          <svg aria-hidden="true" viewBox="0 0 640 512" class="absolute top-[calc(50%-9px)] right-6 size-[18px] fill-current text-grey"><path d="M224 256a128 128 0 1 0 0-256 128 128 0 1 0 0 256zm-45.7 48C79.8 304 0 383.8 0 482.3 0 498.7 13.3 512 29.7 512h388.6c16.4 0 29.7-13.3 29.7-29.7 0-98.5-79.8-178.3-178.3-178.3zM625 177 497 305a24 24 0 0 1-34 0l-64-64a24 24 0 0 1 34-34l47 47 111-111a24 24 0 0 1 34 34z" /></svg>
        </RadioCard>
        <RadioCard name="is_physician" value="2" label={s.pickMyself}>
          <svg aria-hidden="true" viewBox="0 0 512 512" class="absolute top-[calc(50%-9px)] right-6 size-[18px] fill-current text-grey"><path d="M256 0a256 256 0 1 0 0 512 256 256 0 1 0 0-512zm0 96a160 160 0 1 1 0 320 160 160 0 1 1 0-320zm0 64a96 96 0 1 0 0 192 96 96 0 1 0 0-192zm0 64a32 32 0 1 1 0 64 32 32 0 1 1 0-64z" /></svg>
        </RadioCard>
      </div>
      <FieldError>{s.errMode}</FieldError>
    </fieldset>

    <fieldset id="box-physician" class="group mt-4" data-field="physician" hidden>
      <legend class="sr-only">{s.choosePhysicianWanted}</legend>
      {
        groups.map((g) => (
          <div data-group={g.id} hidden>
            <Carousel perView={[1.3, 2, 2, 4]}>
              {g.teams.map((t) => (
                <div class="swiper-slide py-8">
                  <div class="flex h-full flex-col py-[15px]">
                    <label class="relative flex-1 cursor-pointer rounded-t-2xl bg-white p-[15px] text-center shadow-soft transition has-checked:bg-teal has-checked:text-white has-focus-visible:outline-2 has-focus-visible:outline-navy">
                      <input type="radio" class="sr-only" name="physician" value={String(t.id)} data-group={g.id} />
                      <div class="px-8">
                        <img
                          class="mx-auto block aspect-square w-full rounded-full border-[10px] border-white object-cover shadow-soft"
                          src={img.team(t)}
                          alt=""
                          loading="lazy"
                        />
                      </div>
                      <h5 class="mt-3 mb-2 text-base font-normal">{pick(t, 'title', lang)}</h5>
                      <p class="text-sm leading-6">{pick(t, 'proficient', lang)}</p>
                      {pick(t, 'remark', lang) && <p class="text-sm leading-6 text-[#a94442]">**{pick(t, 'remark', lang)}</p>}
                    </label>
                    <div class="rounded-b-2xl bg-[#f2f2f2] p-[15px] text-center shadow-soft">
                      <a href={url(lang, `teams/detail/${t.id}`)} target="_blank" rel="noopener" class="font-bold text-navy hover:text-teal-dark">
                        {s.details}
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </Carousel>
          </div>
        ))
      }
      <FieldError>{s.errPhysician}</FieldError>
    </fieldset>
    <NavButtons lang={lang} back="appointment/step1" />
  </form>
</Wizard>

<script>
  import { load, save, setError, langPrefix } from './state';

  const form = document.getElementById('appt-step2') as HTMLFormElement;
  const box = document.getElementById('box-physician') as HTMLElement;
  const params = new URLSearchParams(location.search);
  const saved = load();

  // ?is_services=... (links from service/team pages) also fills step 1, like the legacy controller.
  const isServices = params.get('is_services');
  if (isServices) save({ step1: { is_services: isServices } });

  // Query (?group, ?physician, ?id) wins over this visitor's saved choice.
  const groupBoxes = [...box.querySelectorAll<HTMLElement>('div[data-group]')];
  const wanted = params.get('group') ?? saved.step2?.group ?? '1';
  const group = groupBoxes.some((g) => g.dataset.group === wanted) ? wanted : (groupBoxes[0]?.dataset.group ?? '1');
  groupBoxes.forEach((g) => (g.hidden = g.dataset.group !== group));

  const modeValue = params.get('physician') ?? saved.step2?.is_physician;
  const physicianValue = params.get('id') ?? saved.step2?.physician;
  const check = (name: string, value: string | null | undefined) => {
    if (!value) return;
    const input = [...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`)].find(
      (i) => i.value === value && (name !== 'physician' || i.dataset.group === group),
    );
    if (input) input.checked = true;
  };
  check('is_physician', modeValue);
  check('physician', physicianValue);

  const mode = () => form.querySelector<HTMLInputElement>('input[name="is_physician"]:checked')?.value;
  const syncBox = () => (box.hidden = mode() !== '2');
  syncBox();

  form.addEventListener('change', (e) => {
    const name = (e.target as HTMLInputElement).name;
    if (name === 'is_physician') {
      syncBox();
      setError(form, 'is_physician', null);
    }
    if (name === 'physician') setError(form, 'physician', null);
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const m = mode();
    const physician =
      form.querySelector<HTMLInputElement>(`input[name="physician"][data-group="${group}"]:checked`)?.value ?? '';
    setError(form, 'is_physician', m ? null : 'required');
    setError(form, 'physician', m === '2' && !physician ? 'required' : null);
    if (!m || (m === '2' && !physician)) return;
    save({ step2: { group, is_physician: m, physician: m === '2' ? physician : '' } });
    location.href = `${langPrefix()}/appointment/step3`;
  });
</script>
