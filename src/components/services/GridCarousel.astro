---
/**
 * Swiper used by the legacy services index/all views:
 * slidesPerView 1.3 / 2 / 2 / 4, and at >=1024 two rows filled by row
 * (Swiper 4 slidesPerColumn: 2, slidesPerColumnFill: 'row' -> Grid module).
 * Children must be <div class="swiper-slide">.
 */
interface Props {
  /** spaceBetween below 640px (index uses 10, all uses 20) */
  gap?: number;
  class?: string;
}
const { gap = 10, class: className } = Astro.props;
---

<div class:list={['swiper', className]} data-services-grid={gap}>
  <div class="swiper-wrapper">
    <slot />
  </div>
  <div class="swiper-pagination"></div>
  <div class="swiper-button-prev"></div>
  <div class="swiper-button-next"></div>
</div>

<script>
  import Swiper from 'swiper';
  import { Grid, Navigation, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/grid';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';

  for (const el of document.querySelectorAll<HTMLElement>('[data-services-grid]')) {
    new Swiper(el, {
      modules: [Navigation, Pagination, Grid],
      slidesPerView: 1.3,
      spaceBetween: Number(el.dataset.servicesGrid) || 10,
      watchSlidesProgress: true,
      grabCursor: true,
      observer: true,
      observeParents: true,
      grid: { rows: 1 },
      pagination: { el: el.querySelector<HTMLElement>('.swiper-pagination'), clickable: true },
      navigation: {
        nextEl: el.querySelector<HTMLElement>('.swiper-button-next'),
        prevEl: el.querySelector<HTMLElement>('.swiper-button-prev'),
      },
      breakpoints: {
        640: { slidesPerView: 2, spaceBetween: 20, grid: { rows: 1 } },
        768: { slidesPerView: 2, spaceBetween: 20, grid: { rows: 1 } },
        1024: { slidesPerView: 4, spaceBetween: 20, grid: { rows: 2, fill: 'row' } },
      },
    });
  }
</script>
