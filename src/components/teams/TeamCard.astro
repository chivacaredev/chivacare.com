---
/** Circular-thumbnail card from the legacy .main-physical slider (teams/index + teams/detail). */
import { pick, type Lang } from '../../lib/i18n';
import type { Row } from '../../lib/db';
import { appointmentUrl, detailUrl, teamPhoto, tt } from './teams';

interface Props {
  lang: Lang;
  team: Row;
  /** Subtitle under the name; defaults to the team's proficient_* field. */
  subtitle?: string;
}

const { lang, team, subtitle } = Astro.props;
const name = pick(team, 'title', lang);
const href = detailUrl(lang, team);
---

<div class="swiper-slide py-8">
  <div class="flex h-full flex-col py-4">
    <a
      href={href}
      class="block flex-1 rounded-t-2xl bg-white px-4 py-4 text-ink shadow-soft hover:text-teal-dark"
    >
      <div class="px-8 text-center">
        <img
          class="mx-auto aspect-square w-full max-w-[220px] rounded-full border-[10px] border-white object-cover shadow-soft"
          src={teamPhoto(team)}
          alt={team.photomain}
          title={name}
          loading="lazy"
        />
      </div>
      <h5 class="mt-3 text-center text-lg font-bold">{name}</h5>
      <p class="mt-2 text-center">{subtitle ?? pick(team, 'proficient', lang)}</p>
    </a>
    <div class="grid grid-cols-2 rounded-b-2xl bg-[#f2f2f2] py-4 text-center shadow-soft">
      <a href={appointmentUrl(lang, team)} class="font-bold text-ink hover:text-teal-dark">
        {tt(lang, 'appointment')}
      </a>
      <a href={href} class="font-bold text-ink hover:text-teal-dark">{tt(lang, 'detail')}</a>
    </div>
  </div>
</div>
