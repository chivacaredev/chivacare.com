---
import { getMenu, theme } from '../lib/db';
import { LANGS, pick, switchLang, url, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  alternates?: Partial<Record<Lang, string>>;
}

const { lang, alternates } = Astro.props;
const langHref = (l: Lang) => alternates?.[l] ?? switchLang(Astro.url.pathname, l);
const menu = getMenu(lang, (p) => url(lang, p));
const others = LANGS.filter((l) => l !== lang);
const flag = { th: '🇹🇭', en: '🇬🇧' } as const;
const langLabel = { th: 'ไทย', en: 'English' } as const;
---

<header id="site-header" class="sticky top-0 z-50 bg-white shadow-blue">
  <div class="flex items-center justify-between px-4 lg:px-6">
    <a href={url(lang)} class="shrink-0">
      <img id="logo" src={theme('logo-chivacare.png')} alt="ChivaCare" class="max-w-[150px] py-3 md:max-w-[200px] md:p-[15px]" />
    </a>

    <!-- Desktop menu -->
    <nav class="hidden items-center lg:flex" aria-label="Main">
      <ul class="flex items-center">
        {
          menu.map((item, i) => (
            <li class="group relative">
              {item.href ? (
                <a href={item.href} class="block px-3 py-7 text-[15px] font-normal text-ink hover:text-teal xl:px-4">
                  {pick(item.row, 'name', lang)}
                </a>
              ) : (
                <button type="button" class="flex cursor-default items-center gap-1 px-3 py-7 text-[15px] font-normal text-ink group-hover:text-teal xl:px-4">
                  {pick(item.row, 'name', lang)}
                  <svg class="size-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M5.5 7.5 10 12l4.5-4.5" stroke="currentColor" stroke-width="2" fill="none" />
                  </svg>
                </button>
              )}
              {item.children.length > 0 && (
                <ul class:list={['invisible absolute top-full min-w-64 bg-white opacity-0 shadow-blue transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100',
                  // Items in the right half open leftwards so the dropdown stays on screen.
                  i < menu.length / 2 ? 'left-0' : 'right-0',
                ]}>
                  {item.children.map((sub) => (
                    <li class="group/sub relative border-b border-[#e7edff] last:border-0">
                      <a href={sub.href ?? '#'} class="block px-5 py-3 text-sm text-ink hover:bg-teal/10 hover:text-teal">
                        {pick(sub.row, 'name', lang)}
                      </a>
                      {sub.children.length > 0 && (
                        <ul class:list={['invisible absolute top-0 min-w-56 bg-white opacity-0 shadow-blue transition group-hover/sub:visible group-hover/sub:opacity-100', i < menu.length / 2 ? 'left-full' : 'right-full']}>
                          {sub.children.map((leaf) => (
                            <li>
                              <a href={leaf.href ?? '#'} class="block px-5 py-3 text-sm text-ink hover:bg-teal/10 hover:text-teal">
                                {pick(leaf.row, 'name', lang)}
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <div class="group relative ml-2">
        <button type="button" class="flex items-center gap-1 px-3 py-7 text-sm" aria-label="Language">
          <span aria-hidden="true">{flag[lang]}</span>
          <svg class="size-3" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M5.5 7.5 10 12l4.5-4.5" stroke="currentColor" stroke-width="2" fill="none" />
          </svg>
        </button>
        <ul class="invisible absolute top-full right-0 min-w-36 bg-white opacity-0 shadow-blue transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
          {
            others.map((l) => (
              <li>
                <a href={langHref(l)} class="flex items-center gap-2 px-4 py-3 text-sm hover:bg-teal/10" hreflang={l}>
                  <span aria-hidden="true">{flag[l]}</span>
                  {langLabel[l]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <!-- Mobile toggle -->
    <button type="button" id="mobile-toggle" class="p-2 lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu">
      <svg class="size-10" viewBox="0 0 48 48" fill="currentColor" aria-hidden="true">
        <rect x="10" y="16" width="23" height="2"></rect>
        <rect x="10" y="23" width="23" height="2"></rect>
        <rect x="10" y="30" width="23" height="2"></rect>
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <nav id="mobile-menu" class="hidden max-h-[calc(100vh-80px)] overflow-y-auto border-t border-[#e7edff] lg:hidden" aria-label="Main">
    <ul>
      {
        menu.map((item) => (
          <li class="border-b border-[#e7edff]">
            {item.children.length > 0 ? (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-3">
                  {item.href ? <a href={item.href}>{pick(item.row, 'name', lang)}</a> : <span>{pick(item.row, 'name', lang)}</span>}
                  <span class="text-xl leading-none transition group-open:rotate-45">+</span>
                </summary>
                <ul class="bg-gray-50">
                  {item.children.map((sub) => (
                    <li>
                      <a href={sub.href ?? '#'} class="block py-2.5 pr-5 pl-9 text-sm">
                        {pick(sub.row, 'name', lang)}
                      </a>
                      {sub.children.map((leaf) => (
                        <a href={leaf.href ?? '#'} class="block py-2 pr-5 pl-14 text-sm">
                          {pick(leaf.row, 'name', lang)}
                        </a>
                      ))}
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={item.href ?? '#'} class="block px-5 py-3">
                {pick(item.row, 'name', lang)}
              </a>
            )}
          </li>
        ))
      }
      <li class="flex gap-4 px-5 py-3">
        {
          LANGS.map((l) => (
            <a href={langHref(l)} class:list={['flex items-center gap-1 text-sm', l === lang && 'font-medium text-teal']} hreflang={l}>
              <span aria-hidden="true">{flag[l]}</span>
              {langLabel[l]}
            </a>
          ))
        }
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
