---
const pathname = Astro.url.pathname;
const isActive = (path: string) => pathname === path || pathname.startsWith(path + '/');

// Build TH equivalent: prepend /th (e.g. /blog/43 → /th/blog/43)
const thPath = '/th' + (pathname === '/' ? '' : pathname);
---

<nav id="slide-nav" class="yamm navbar navbar-default" role="navigation">
  <div id="topbar">
    <div class="container"></div>
  </div>
  <div class="bg-menu" style="position:relative;">
    <div class="lang-switcher hidden-xs">
      <div class="lang-pill-wrapper">
        <a href={pathname} class="lang-pill lang-pill--active" aria-label="English">🇬🇧 <span>EN</span></a>
        <a href={thPath} class="lang-pill" aria-label="ภาษาไทย">🇹🇭 <span>TH</span></a>
      </div>
    </div>
    <div class="container-fluid _box-shadow">
      <div class="navbar-header">
        <a class="navbar-brand" href="/">
          <img id="logo" class="img-responsive animated slideInDown adl-1"
               src="https://chivacare.com/assets/layouts/frontend/images/logo-chivacare.png"
               alt="Chivacare" />
        </a>
        <div class="mobile-menu">
          <div class="header_bar">
            <div class="mobile-toggle pull-right">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" focusable="false">
                <g>
                  <rect x="10" y="16" width="23" height="2"></rect>
                  <rect x="10" y="23" width="23" height="2"></rect>
                  <rect x="10" y="30" width="23" height="2"></rect>
                </g>
              </svg>
            </div>
          </div>
          <nav class="primary-nav">
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/teams">Medical Team & Specialists</a></li>
              <li>
                <a class="a-toggle" href="javascript:;">Our Services</a>
                <span class="item-toggle-button">Toggle</span>
                <div class="secondary-nav">
                  <ul>
                    <li><a href="/services/brain-clinic">Brain & Nervous System Clinic</a></li>
                    <li><a href="/services/physical-therapy">Physical & Occupational Therapy Clinic</a></li>
                    <li><a href="/services/geriatric-rehab">Geriatric Rehabilitation Center</a></li>
                  </ul>
                </div>
              </li>
              <li>
                <a class="a-toggle" href="javascript:;">Service Rates</a>
                <span class="item-toggle-button">Toggle</span>
                <div class="secondary-nav">
                  <ul>
                    <li><a href="/pricing/brain-clinic">Brain Clinic Rates</a></li>
                    <li><a href="/pricing/physical-therapy">Physical & Occupational Therapy Rates</a></li>
                  </ul>
                </div>
              </li>
              <li><a href="/promotions">Promotions</a></li>
              <li><a href="/assessment">Self-Assessment</a></li>
              <li>
                <a class="a-toggle" href="javascript:;">News & Articles</a>
                <span class="item-toggle-button">Toggle</span>
                <div class="secondary-nav">
                  <ul>
                    <li><a href="/blog">Health Articles</a></li>
                    <li><a href="/news">News & Events</a></li>
                  </ul>
                </div>
              </li>
              <li>
                <a class="a-toggle" href="/contactus">Contact Us</a>
                <span class="item-toggle-button">Toggle</span>
                <div class="secondary-nav">
                  <ul>
                    <li><a href="/privacy">Privacy Policy</a></li>
                  </ul>
                </div>
              </li>
            </ul>
          </nav>
        </div>
      </div>

      <!-- Desktop nav -->
      <div class="topmenu collapse navbar-collapse" id="bs-example-navbar-collapse-1">
        <div class="desktop-menu">
          <nav class="nav navbar-nav navbar-left primary-nav">
            <ul>
              <li class={isActive('/') && pathname === '/' ? 'active' : ''}>
                <a href="/">Home</a>
              </li>
              <li class={isActive('/teams') ? 'active' : ''}>
                <a href="/teams">Medical Team & Specialists</a>
              </li>
              <li class={isActive('/services') ? 'active' : ''}>
                <a class="a-toggle" href="javascript:;">Our Services</a>
                <span class="item-toggle-button">Toggle</span>
                <div class="secondary-nav submenu-box">
                  <ul>
                    <li><a href="/services/brain-clinic">Brain & Nervous System Clinic</a></li>
                    <li><a href="/services/physical-therapy">Physical & Occupational Therapy Clinic</a></li>
                    <li><a href="/services/geriatric-rehab">Geriatric Rehabilitation Center</a></li>
                  </ul>
                </div>
              </li>
              <li class={isActive('/pricing') ? 'active' : ''}>
                <a class="a-toggle" href="javascript:;">Service Rates</a>
                <span class="item-toggle-button">Toggle</span>
                <div class="secondary-nav submenu-box">
                  <ul>
                    <li><a href="/pricing/brain-clinic">Brain Clinic Rates</a></li>
                    <li><a href="/pricing/physical-therapy">Physical & Occupational Therapy Rates</a></li>
                  </ul>
                </div>
              </li>
              <li class={isActive('/promotions') ? 'active' : ''}>
                <a href="/promotions">Promotions</a>
              </li>
              <li class={isActive('/assessment') ? 'active' : ''}>
                <a href="/assessment">Self-Assessment</a>
              </li>
              <li class={isActive('/blog') || isActive('/news') ? 'active' : ''}>
                <a class="a-toggle" href="javascript:;">News & Articles</a>
                <span class="item-toggle-button">Toggle</span>
                <div class="secondary-nav submenu-box">
                  <ul>
                    <li><a href="/blog">Health Articles</a></li>
                    <li><a href="/news">News & Events</a></li>
                  </ul>
                </div>
              </li>
              <li class={isActive('/contactus') ? 'active' : ''}>
                <a class="a-toggle" href="/contactus">Contact Us</a>
                <span class="item-toggle-button">Toggle</span>
                <div class="secondary-nav submenu-box">
                  <ul>
                    <li><a href="/privacy">Privacy Policy</a></li>
                  </ul>
                </div>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>
</nav>
