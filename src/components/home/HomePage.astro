---
/** Home page — port of application/modules/home/views/home.php, section by section. */
import Layout from '../../layouts/Layout.astro';
import type { Lang } from '../../lib/i18n';
import MainClinic from './MainClinic.astro';
import Promotions from './Promotions.astro';
import Why from './Why.astro';
import DoctorBanner from './DoctorBanner.astro';
import Certificates from './Certificates.astro';
import ServicesTabs from './ServicesTabs.astro';
import Videos from './Videos.astro';
import Blogs from './Blogs.astro';
import Reviews from './Reviews.astro';
import AboutUs from './AboutUs.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Layout lang={lang}>
  <MainClinic lang={lang} />
  <Promotions lang={lang} />
  <Why lang={lang} />
  <DoctorBanner lang={lang} />
  <Certificates lang={lang} />
  <ServicesTabs lang={lang} />
  <Videos lang={lang} />
  <Blogs lang={lang} />
  <Reviews lang={lang} />
  <AboutUs lang={lang} />
</Layout>
