---
import Carousel from '../Carousel.astro';
import MoreLink from './MoreLink.astro';
import { getBlogs, img } from '../../lib/db';
import { pick, t, url, type Lang } from '../../lib/i18n';
import { slug, truncate } from '../../lib/text';
import { hasImage, ht, OVERFLOW_CAROUSEL } from './helpers';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = ht(lang);
const blogs = getBlogs().filter((b) => hasImage(img.blog(b.photomain)));
---

<section class="mb-12">
  <div class="container-site">
    <div class="overflow-hidden">
      <h2 class="section-title">{s.blogs}</h2>
      {
        blogs.length > 0 ? (
          <>
            <Carousel perView={[1.3, 2, 2, 4]} class={`mt-12 ${OVERFLOW_CAROUSEL}`}>
              {blogs.map((b) => {
                const title = pick(b, 'title', lang);
                const href = url(lang, `blog/${b.id}/${slug(title)}`);
                return (
                  <div class="swiper-slide py-8">
                    <div class="card">
                      <a href={href} target="_blank">
                        <img src={img.blog(b.photomain)} alt={title} title={title} loading="lazy" class="block h-auto w-full" />
                      </a>
                      <div class="px-[15px] pt-2.5">
                        <a href={href} target="_blank" class="hover:text-teal">
                          <h4 class="truncate font-bold!">{title}</h4>
                        </a>
                        <p>{truncate(pick(b, 'description', lang), 120)}</p>
                      </div>
                    </div>
                  </div>
                );
              })}
            </Carousel>
            <MoreLink href={url(lang, 'blog')}>{s.moreBlogs}</MoreLink>
          </>
        ) : (
          <div class="text-center">{t(lang, 'notFound')}</div>
        )
      }
    </div>
  </div>
</section>
