---
/**
 * Card used in the "other items" carousels and the reviews list
 * (legacy .content-wrapper._bsd-default: image on top, title + short description).
 */
import type { Row } from '../../lib/db';
import { pick, type Lang } from '../../lib/i18n';
import { truncate } from '../../lib/text';
import ArticleImage from './ArticleImage.astro';
import { detailUrl, type ModuleKey } from './modules';

interface Props {
  mod: ModuleKey;
  row: Row;
  lang: Lang;
  /** title_text() length; omit to show the full title */
  titleLength?: number;
  descLength?: number;
}

const { mod, row, lang, titleLength, descLength = 85 } = Astro.props;
const title = pick(row, 'title', lang);
---

<a href={detailUrl(mod, row, lang)} target="_blank" class="card text-ink">
  <ArticleImage mod={mod} row={row} lang={lang} />
  <div class="flex-1 px-4 pt-3 pb-2">
    <h4>{titleLength ? truncate(title, titleLength) : title}</h4>
    <p>{truncate(pick(row, 'description', lang), descLength)}</p>
  </div>
</a>
