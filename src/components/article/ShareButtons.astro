---
/** Plain share links replacing the legacy ShareThis inline buttons. */
import type { Lang } from '../../lib/i18n';
import { SHARE_LABEL } from './modules';

interface Props {
  lang: Lang;
  /** Root-relative or absolute URL of the page to share */
  href: string;
  title: string;
  class?: string;
}

const { lang, href, title, class: className } = Astro.props;
const abs = new URL(href, Astro.site ?? Astro.url).href;
const u = encodeURIComponent(abs);
const tt = encodeURIComponent(title);
const links = [
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, bg: 'bg-[#3b5998]', icon: 'M14 8h3V4h-3c-2.8 0-4 1.8-4 4v2H8v4h2v8h4v-8h3l1-4h-4V8.5c0-.3.2-.5.5-.5Z' },
  { name: 'LINE', href: `https://social-plugins.line.me/lineit/share?url=${u}`, bg: 'bg-[#00c300]', icon: 'M12 4C6.5 4 2 7.6 2 12c0 4 3.6 7.3 8.4 7.9.3.1.8.2.9.5.1.3 0 .7 0 1l-.1.9c0 .3-.2 1 .9.5s6-3.5 8.1-6C21.4 15.3 22 13.7 22 12c0-4.4-4.5-8-10-8Zm-3.8 10.4H6.3c-.3 0-.5-.2-.5-.5V10c0-.3.2-.5.5-.5s.5.2.5.5v3.4h1.4c.3 0 .5.2.5.5s-.2.5-.5.5Zm2-.5c0 .3-.2.5-.5.5s-.5-.2-.5-.5V10c0-.3.2-.5.5-.5s.5.2.5.5v3.9Zm4.6 0c0 .2-.1.4-.3.5h-.2c-.2 0-.3-.1-.4-.2l-2-2.7v2.4c0 .3-.2.5-.5.5s-.5-.2-.5-.5V10c0-.2.1-.4.3-.5h.2c.2 0 .3.1.4.2l2 2.7V10c0-.3.2-.5.5-.5s.5.2.5.5v3.9Zm3.1-2.5c.3 0 .5.2.5.5s-.2.5-.5.5h-1.4v.9h1.4c.3 0 .5.2.5.5s-.2.5-.5.5h-1.9c-.3 0-.5-.2-.5-.5V10c0-.3.2-.5.5-.5h1.9c.3 0 .5.2.5.5s-.2.5-.5.5h-1.4v.9h1.4Z' },
  { name: 'X', href: `https://twitter.com/intent/tweet?url=${u}&text=${tt}`, bg: 'bg-black', icon: 'M17.8 3h3.1l-6.7 7.7L22 21h-6.2l-4.8-6.3L5.5 21H2.4l7.2-8.2L2 3h6.3l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z' },
];
---

<div class:list={['flex flex-wrap items-center justify-center gap-2', className]}>
  <span class="mr-1 inline-flex items-center gap-1 text-sm">
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle>
      <path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"></path>
    </svg>
    {SHARE_LABEL[lang]}
  </span>
  {
    links.map((l) => (
      <a href={l.href} target="_blank" rel="noopener noreferrer" class:list={['inline-flex size-8 items-center justify-center rounded text-white hover:opacity-80', l.bg]} title={l.name}>
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={l.icon} /></svg>
        <span class="sr-only">{l.name}</span>
      </a>
    ))
  }
  <button
    type="button"
    data-copy-link={abs}
    data-copied={lang === 'th' ? 'คัดลอกแล้ว' : 'Copied'}
    class="inline-flex h-8 items-center justify-center gap-1 rounded bg-grey px-2 text-xs text-white hover:opacity-80"
    title={lang === 'th' ? 'คัดลอกลิงก์' : 'Copy link'}
  >
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path>
    </svg>
    <span data-copy-text>{lang === 'th' ? 'คัดลอกลิงก์' : 'Copy link'}</span>
  </button>
</div>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-link]')) {
    btn.addEventListener('click', async () => {
      const text = btn.querySelector<HTMLElement>('[data-copy-text]');
      const original = text?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(btn.dataset.copyLink ?? location.href);
        if (text) text.textContent = btn.dataset.copied ?? 'Copied';
        setTimeout(() => text && (text.textContent = original), 1500);
      } catch {
        window.prompt('', btn.dataset.copyLink ?? location.href);
      }
    });
  }
</script>
