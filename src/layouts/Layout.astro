---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieAlert from '../components/CookieAlert.astro';
import { site } from '../lib/db';
import { pick, type Lang } from '../lib/i18n';
import { stripHtml } from '../lib/text';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  keywords?: string;
  /** og:image, absolute or root-relative */
  image?: string;
  /**
   * Same page in other languages, for pages whose slug differs per language.
   * Without it the language switcher just swaps the /th or /en prefix.
   */
  alternates?: Partial<Record<Lang, string>>;
}

const { lang, title, description, keywords, image, alternates } = Astro.props;
const siteTitle = pick(site, 'title', lang);
const pageTitle = title ? stripHtml(title) : siteTitle;
const pageDescription = stripHtml(description || pick(site, 'description', lang));
const pageKeywords = keywords || title || pick(site, 'keyword', lang);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImage = image ? new URL(image, Astro.site ?? Astro.url).href : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={stripHtml(pageKeywords)} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#30c1b8" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <link rel="image_src" href={ogImage} />}
    {alternates && Object.entries(alternates).map(([l, href]) => <link rel="alternate" hreflang={l} href={new URL(href!, Astro.site ?? Astro.url).href} />)}
    <meta property="fb:app_id" content="734543687132120" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Prompt:wght@100;200;300;400;500;600&family=Sarabun:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <!-- Google Tag Manager (legacy container) -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-MMQPKFV');
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MMQPKFV" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <Header lang={lang} alternates={alternates} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieAlert lang={lang} />
  </body>
</html>
